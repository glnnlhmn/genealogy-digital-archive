*.bk
*.bak
*.bk.*
*.bak.*
*.[0-9]*.bk
gda_config.json.bk
backups/

# =====================================================================
# DATA EXCLUSION & WHITELISTS (Privacy & Static References)
# =====================================================================
# Exclude raw genealogical trees and intake data
GEDCOM/
*.ged
*gedcom*.json
import/

# Protect living privacy in data/, but whitelist static reference tables and profile ledger
data/
!data/reference/
!data/reference/**
!data/profiles/
!data/profiles/gda_profile.json

# =====================================================================
# PERSONAL USER PROFILES & PRIVATE PROMPTS
# =====================================================================
prompts/core/Glenn*
prompts/archive/

# =====================================================================
# Ephemeral Chat Downloads, Workspace, Logs & Reports
# =====================================================================
gemini-code-*.*
gtemp/*
!gtemp/.gitkeep
logs/
reports/

# =====================================================================
# ARCHIVED & LEGACY SCHEMAS / DEFINITIONS
# =====================================================================
schemas/archive/
schemas/defs/*_definitions.schema.json