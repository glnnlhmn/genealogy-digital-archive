{
  "_name": "fact_registry.schema.json",
  "_path": "schemas/entities/fact_registry.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://genealogy.archive/schemas/entities/fact_registry.schema.json",
  "title": "Fact_Registry",
  "version": "1.0.2",
  "description": "Master administrative registry container for discrete fact assertions.",
  "type": "object",
  "required": [
    "_name",
    "_path",
    "$schema",
    "schema_version",
    "created_at",
    "last_modified",
    "total_facts",
    "facts"
  ],
  "properties": {
    "_name": {
      "type": "string",
      "const": "facts.json"
    },
    "_path": {
      "type": "string",
      "const": "data/entities/facts.json"
    },
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "type": "string",
      "const": "1.0.2"
    },
    "created_at": {
      "type": "string"
    },
    "last_modified": {
      "type": "string"
    },
    "total_facts": {
      "type": "integer",
      "minimum": 0,
      "description": "Total count of discrete fact assertions contained in the registry."
    },
    "facts": {
      "type": "array",
      "description": "List of master fact assertion records.",
      "items": {
        "$ref": "fact.schema.json"
      }
    }
  },
  "additionalProperties": false
}
