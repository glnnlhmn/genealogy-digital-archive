{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://genealogy.archive/schemas/entities/fact_registry.schema.json",
  "title": "Fact_Registry",
  "version": "1.0.1",
  "description": "Top-level container envelope for the centralized facts registry.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "const": "1.0.1"
    },
    "generated_at": {
      "type": "string"
    },
    "total_facts": {
      "type": "integer",
      "minimum": 0
    },
    "facts": {
      "type": "array",
      "items": {
        "$ref": "fact.schema.json"
      }
    }
  },
  "required": [
    "schema_version",
    "total_facts",
    "facts"
  ],
  "additionalProperties": false
}