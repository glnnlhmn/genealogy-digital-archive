{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://genealogy.archive/schemas/entities/location_registry.schema.json",
  "title": "Location_Registry",
  "version": "1.0.0",
  "description": "Master administrative registry container for individual location entities, utilizing centralized registry definitions.",
  "type": "object",
  "required": [
    "$schema",
    "schema_version",
    "created_at",
    "last_modified",
    "total_locations",
    "locations"
  ],
  "properties": {
    "$schema": {
      "$ref": "../defs/_registry_shared_defs.schema.json#/$defs/registry_header/properties/$schema"
    },
    "schema_version": {
      "$ref": "../defs/_registry_shared_defs.schema.json#/$defs/registry_header/properties/schema_version",
      "const": "1.0.0"
    },
    "created_at": {
      "$ref": "../defs/_registry_shared_defs.schema.json#/$defs/registry_header/properties/created_at"
    },
    "last_modified": {
      "$ref": "../defs/_registry_shared_defs.schema.json#/$defs/registry_header/properties/last_modified"
    },
    "total_locations": {
      "$ref": "../defs/_registry_shared_defs.schema.json#/$defs/total_count",
      "description": "Total count of location entities contained in the registry."
    },
    "locations": {
      "type": "array",
      "description": "List of master location records.",
      "items": {
        "$ref": "location.schema.json"
      }
    }
  },
  "additionalProperties": false
}