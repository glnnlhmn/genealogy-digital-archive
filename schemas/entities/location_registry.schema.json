{
  "_name": "location_registry.schema.json",
  "_path": "schemas/entities/location_registry.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://genealogy.archive/schemas/entities/location_registry.schema.json",
  "title": "Location Registry Schema",
  "version": "1.2.0",
  "description": "Master administrative registry envelope for locations.json, including required GSI intake headers.",
  "type": "object",
  "required": [
    "_name",
    "_path",
    "$schema",
    "schema_version",
    "created_at",
    "last_modified",
    "total_locations",
    "locations"
  ],
  "properties": {
    "_name": {
      "type": "string",
      "const": "locations.json"
    },
    "_path": {
      "type": "string",
      "const": "data/entities/locations.json"
    },
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "type": "string",
      "const": "1.2.0"
    },
    "created_at": {
      "type": "string"
    },
    "last_modified": {
      "type": "string"
    },
    "total_locations": {
      "type": "integer",
      "minimum": 0
    },
    "locations": {
      "type": "array",
      "description": "Authoritative list of master civil jurisdictions.",
      "items": {
        "$ref": "location.schema.json"
      }
    }
  },
  "additionalProperties": false
}