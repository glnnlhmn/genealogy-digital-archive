{
  "_name": "person_registry.schema.json",
  "_path": "schemas/entities/person_registry.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://genealogy.archive/schemas/entities/person_registry.schema.json",
  "title": "Person_Registry",
  "version": "1.0.2",
  "description": "Master administrative registry container for individual person entities.",
  "type": "object",
  "required": [
    "_name",
    "_path",
    "$schema",
    "schema_version",
    "created_at",
    "last_modified",
    "total_persons",
    "persons"
  ],
  "properties": {
    "_name": {
      "type": "string",
      "const": "people.json"
    },
    "_path": {
      "type": "string",
      "const": "data/entities/people.json"
    },
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "type": "string",
      "const": "1.0.2"
    },
    "created_at": {
      "type": "string"
    },
    "last_modified": {
      "type": "string"
    },
    "total_persons": {
      "type": "integer",
      "minimum": 0,
      "description": "Total count of person entities contained in the registry."
    },
    "persons": {
      "type": "array",
      "description": "List of master person records.",
      "items": {
        "$ref": "person.schema.json"
      }
    }
  },
  "additionalProperties": false
}
