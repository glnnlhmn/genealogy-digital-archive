{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://genealogy.archive/schemas/defs/_census_definitions.schema.json",
  "title": "Census_Definitions",
  "version": "1.0.1",
  "description": "Era-specific schedule columns, tally brackets, line items, and page metadata for U.S. Federal Censuses (1790–1950).",
  "$defs": {
    "census_page_metadata": {
      "type": "object",
      "required": ["state", "county", "civil_subdivision", "sheet"],
      "properties": {
        "state": {
          "type": "string",
          "description": "Two-letter state postal abbreviation or state name."
        },
        "county": {
          "type": "string",
          "description": "County name."
        },
        "civil_subdivision": {
          "type": "string",
          "description": "Township, borough, town, city, precinct, or magisterial district."
        },
        "ward": { "type": ["string", "null"] },
        "supervisor_district": { "type": ["string", "null"] },
        "enumeration_district": { "type": ["string", "null"] },
        "sheet": {
          "type": "string",
          "description": "Page or sheet identifier (e.g., '140B', 'Sheet 5A', 'Page 72')."
        },
        "enumeration_date": {
          "oneOf": [
            { "$ref": "_shared_definitions.schema.json#/$defs/date_interpreted" },
            { "type": "null" }
          ]
        },
        "enumerator_name": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "census_1790_particulars": {
      "type": "object",
      "description": "Head of household demographic tallies for 1790.",
      "properties": {
        "free_white_males_16_and_up": { "type": ["integer", "null"], "minimum": 0 },
        "free_white_males_under_16": { "type": ["integer", "null"], "minimum": 0 },
        "free_white_females": { "type": ["integer", "null"], "minimum": 0 },
        "all_other_free_persons": { "type": ["integer", "null"], "minimum": 0 },
        "slaves": { "type": ["integer", "null"], "minimum": 0 }
      },
      "additionalProperties": false
    },
    "census_1800_1810_particulars": {
      "type": "object",
      "description": "Head of household demographic tallies for 1800 and 1810.",
      "properties": {
        "males_under_10": { "type": ["integer", "null"], "minimum": 0 },
        "males_10_to_15": { "type": ["integer", "null"], "minimum": 0 },
        "males_16_to_25": { "type": ["integer", "null"], "minimum": 0 },
        "males_26_to_44": { "type": ["integer", "null"], "minimum": 0 },
        "males_45_and_up": { "type": ["integer", "null"], "minimum": 0 },
        "females_under_10": { "type": ["integer", "null"], "minimum": 0 },
        "females_10_to_15": { "type": ["integer", "null"], "minimum": 0 },
        "females_16_to_25": { "type": ["integer", "null"], "minimum": 0 },
        "females_26_to_44": { "type": ["integer", "null"], "minimum": 0 },
        "females_45_and_up": { "type": ["integer", "null"], "minimum": 0 },
        "all_other_free_persons": { "type": ["integer", "null"], "minimum": 0 },
        "slaves": { "type": ["integer", "null"], "minimum": 0 }
      },
      "additionalProperties": false
    },
    "census_1820_particulars": {
      "type": "object",
      "description": "Head of household demographic tallies for 1820.",
      "properties": {
        "males_under_10": { "type": ["integer", "null"], "minimum": 0 },
        "males_10_to_15": { "type": ["integer", "null"], "minimum": 0 },
        "males_16_to_18": { "type": ["integer", "null"], "minimum": 0 },
        "males_16_to_25": { "type": ["integer", "null"], "minimum": 0 },
        "males_26_to_44": { "type": ["integer", "null"], "minimum": 0 },
        "males_45_and_up": { "type": ["integer", "null"], "minimum": 0 },
        "females_under_10": { "type": ["integer", "null"], "minimum": 0 },
        "females_10_to_15": { "type": ["integer", "null"], "minimum": 0 },
        "females_16_to_25": { "type": ["integer", "null"], "minimum": 0 },
        "females_26_to_44": { "type": ["integer", "null"], "minimum": 0 },
        "females_45_and_up": { "type": ["integer", "null"], "minimum": 0 },
        "foreigners_not_naturalized": { "type": ["integer", "null"], "minimum": 0 },
        "engaged_in_agriculture": { "type": ["integer", "null"], "minimum": 0 },
        "engaged_in_commerce": { "type": ["integer", "null"], "minimum": 0 },
        "engaged_in_manufactures": { "type": ["integer", "null"], "minimum": 0 },
        "free_colored_total": { "type": ["integer", "null"], "minimum": 0 },
        "slaves_total": { "type": ["integer", "null"], "minimum": 0 }
      },
      "additionalProperties": false
    },
    "census_1830_1840_particulars": {
      "type": "object",
      "description": "Head of household demographic tallies for 1830 and 1840.",
      "properties": {
        "white_males_by_age": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 },
          "description": "Keys: under_5, 5_9, 10_14, 15_19, 20_29, 30_39, 40_49, 50_59, 60_69, 70_79, 80_89, 90_99, 100_up."
        },
        "white_females_by_age": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 },
          "description": "Keys: under_5, 5_9, 10_14, 15_19, 20_29, 30_39, 40_49, 50_59, 60_69, 70_79, 80_89, 90_99, 100_up."
        },
        "free_colored_total": { "type": ["integer", "null"], "minimum": 0 },
        "slaves_total": { "type": ["integer", "null"], "minimum": 0 },
        "military_pensioners_named": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "population_individual_particulars": {
      "type": "object",
      "description": "Nominal population schedule questions used across 1850–1950 censuses.",
      "properties": {
        "age": {
          "oneOf": [
            { "$ref": "_shared_definitions.schema.json#/$defs/age_record" },
            { "type": "null" }
          ]
        },
        "sex": {
          "type": ["string", "null"],
          "enum": ["Male", "Female", "Unknown", null]
        },
        "color_or_race": { "type": ["string", "null"] },
        "relation_to_head": {
          "type": ["string", "null"],
          "description": "Reported relation (e.g., 'Head', 'Wife', 'Son', 'Boarder', 'Servant')."
        },
        "marital_status": {
          "type": ["string", "null"],
          "enum": ["Single", "Married", "Widowed", "Divorced", null]
        },
        "birth_month": { "type": ["string", "null"] },
        "birth_year": { "type": ["integer", "null"] },
        "birthplace": {
          "oneOf": [
            { "$ref": "_shared_definitions.schema.json#/$defs/location" },
            { "type": "null" }
          ]
        },
        "father_birthplace": {
          "oneOf": [
            { "$ref": "_shared_definitions.schema.json#/$defs/location" },
            { "type": "null" }
          ]
        },
        "mother_birthplace": {
          "oneOf": [
            { "$ref": "_shared_definitions.schema.json#/$defs/location" },
            { "type": "null" }
          ]
        },
        "occupation": {
          "type": "object",
          "properties": {
            "trade": { "type": ["string", "null"] },
            "industry": { "type": ["string", "null"] },
            "class_of_worker": { "type": ["string", "null"] }
          },
          "additionalProperties": false
        },
        "real_estate_value": { "type": ["string", "null"] },
        "personal_estate_value": { "type": ["string", "null"] },
        "immigration_year": { "type": ["integer", "null"] },
        "naturalization_status": {
          "type": ["string", "null"],
          "enum": ["Al", "Pa", "Na", "Unknown", null]
        },
        "can_read": { "type": ["boolean", "null"] },
        "can_write": { "type": ["boolean", "null"] },
        "attended_school": { "type": ["boolean", "null"] },
        "years_married": { "type": ["integer", "null"] },
        "children_born": { "type": ["integer", "null"] },
        "children_living": { "type": ["integer", "null"] },
        "home_owned_or_rented": {
          "type": ["string", "null"],
          "enum": ["Owned", "Rented", "Free", "Mortgaged", null]
        }
      },
      "additionalProperties": false
    },
    "census_line_entry": {
      "type": "object",
      "required": [
        "line_guid",
        "line_urn",
        "line_number",
        "name"
      ],
      "properties": {
        "line_guid": {
          "$ref": "_shared_definitions.schema.json#/$defs/fact_id",
          "description": "[REQUIRED] Canonical UUID uniquely identifying this individual census line entry."
        },
        "line_urn": {
          "type": "string",
          "pattern": "^URN:CENSUS:[0-9]{4}:(?:[A-Z0-9_]+:)*[A-Za-z0-9_-]+:LINE:\\d+$",
          "description": "[REQUIRED] Hierarchical archival URN (e.g., URN:CENSUS:1900:PA_Cumberland_Frankford:ED10S08A:LINE:24)."
        },
        "line_number": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "family_number": { "type": ["string", "null"] },
        "dwelling_number": { "type": ["string", "null"] },
        "person_id": {
          "$ref": "_shared_definitions.schema.json#/$defs/person_id"
        },
        "name": {
          "$ref": "_shared_definitions.schema.json#/$defs/canonical_name"
        },
        "individual_data": {
          "$ref": "#/$defs/population_individual_particulars"
        },
        "tally_brackets": {
          "oneOf": [
            { "$ref": "#/$defs/census_1790_particulars" },
            { "$ref": "#/$defs/census_1800_1810_particulars" },
            { "$ref": "#/$defs/census_1820_particulars" },
            { "$ref": "#/$defs/census_1830_1840_particulars" },
            { "type": "null" }
          ]
        },
        "line_note": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    }
  }
}