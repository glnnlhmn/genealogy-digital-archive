        "HUSB",
        "WIFE",
        "MOTH",
        "FATH",
        "SPOU",
        "SIBL",
        "WITN",
        "GODP",
        "INFORMANT",
        "CLERGY",
        "OFFICIANT",
        "NEIGHBOR",
        "ATND",
        "UNDR",
        "DEC",
        "OTHR",
        "UNKNOWN"
      ]
    },
    "enum_sex": {
      "enum": [
        "M",
        "F",
        "U",
        null
