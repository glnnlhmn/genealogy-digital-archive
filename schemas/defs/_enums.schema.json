{
  "_name": "_enums.schema.json",
  "_path": "schemas/defs/_enums.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://genealogy.archive/schemas/defs/_enums.schema.json",
  "title": "Genealogy_Controlled_Vocabularies",
  "version": "1.2.0",
  "description": "Authoritative single source of truth for controlled taxonomies across the archive.",
  "type": "object",
  "$defs": {
    "enum_fact_type": {
      "type": "string",
      "enum": [
        "Association",
        "Award",
        "Baptism",
        "Birth",
        "Burial",
        "Census",
        "Civic",
        "Death",
        "Divorce",
        "Education",
        "Incident",
        "Legal",
        "Marriage",
        "Military",
        "Occupation",
        "Parentage",
        "Probate",
        "Property",
        "Residence",
        "Other",
        "Unknown"
      ]
    },
    "enum_date_modifier": {
      "type": "string",
      "enum": [
        "EXACT",
        "ABT",
        "BEF",
        "AFT",
        "BET",
        "FROM_TO",
        "UNKNOWN"
      ]
    },
    "enum_vital_date_modifier": {
      "type": "string",
      "enum": [
        "EXACT",
        "ABT",
        "BEF",
        "AFT",
        "BET",
