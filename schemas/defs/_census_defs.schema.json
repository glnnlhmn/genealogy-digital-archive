{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://genealogy.archive/schemas/defs/_census_defs.schema.json",
  "title": "Census_Definitions",
  "version": "1.0.0",
  "description": "Era-specific schedule columns, tally brackets, line items, and page metadata for U.S. Federal Censuses (1790\u20131950).",
  "$defs": {
    "census_page_metadata": {
      "type": "object",
      "unevaluatedProperties": false,
      "required": [
        "state",
        "county",
        "sheet"
      ],
      "properties": {
        "state": {
          "type": "string",
          "description": "Two-letter state postal abbreviation or state name."
        },
        "county": {
          "type": "string",
          "description": "County name."
        },
        "civil_subdivision": {
          "type": [
            "string",
            "null"
          ],
          "description": "Township, borough, town, city, precinct, or magisterial district."
        },
        "ward": {
          "type": [
            "string",
            "null"
          ]
        },
        "supervisor_district": {
          "type": [
            "string",
            "null"
          ]
        },
        "enumeration_district": {
          "type": [
            "string",
            "null"
          ]
        },
        "sheet": {
          "type": "string",
          "description": "Page or sheet identifier."
        },
        "enumeration_date": {
          "type": [
            "object",
            "null"
          ],
          "$ref": "_shared_defs.schema.json#/$defs/date_interpreted"
        },
        "enumerator_name": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "census_1790_particulars": {
      "type": "object",
      "description": "Head of household demographic tallies for 1790.",
      "unevaluatedProperties": false,
      "properties": {
        "free_white_males_16_and_up": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "free_white_males_under_16": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "free_white_females": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "all_other_free_persons": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "slaves": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "census_1800_1810_particulars": {
      "type": "object",
      "description": "Head of household demographic tallies for 1800 and 1810.",
      "unevaluatedProperties": false,
      "properties": {
        "males_under_10": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "males_10_to_15": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "males_16_to_25": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "males_26_to_44": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "males_45_and_up": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "females_under_10": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "females_10_to_15": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "females_16_to_25": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "females_26_to_44": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "females_45_and_up": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "all_other_free_persons": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "slaves": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "census_1820_particulars": {
      "type": "object",
      "description": "Head of household demographic tallies for 1820.",
      "unevaluatedProperties": false,
      "properties": {
        "males_under_10": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "males_10_to_15": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "males_16_to_18": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "males_16_to_25": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "males_26_to_44": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "males_45_and_up": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "females_under_10": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "females_10_to_15": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "females_16_to_25": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "females_26_to_44": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "females_45_and_up": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "foreigners_not_naturalized": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "engaged_in_agriculture": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "engaged_in_commerce": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "engaged_in_manufactures": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "free_colored_total": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "slaves_total": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "census_1830_1840_particulars": {
      "type": "object",
      "description": "Head of household demographic tallies for 1830 and 1840.",
      "unevaluatedProperties": false,
      "properties": {
        "white_males_by_age": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "white_females_by_age": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "free_colored_total": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "slaves_total": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "military_pensioners_named": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "population_individual_particulars": {
      "type": "object",
      "description": "Nominal population schedule questions used across 1850\u20131950 censuses.",
      "unevaluatedProperties": false,
      "properties": {
        "age": {
          "type": [
            "object",
            "null"
          ],
          "$ref": "_shared_defs.schema.json#/$defs/age_record"
        },
        "sex": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "Male",
            "Female",
            "Unknown",
            null
          ]
        },
        "color_or_race": {
          "type": [
            "string",
            "null"
          ]
        },
        "relation_to_head": {
          "type": [
            "string",
            "null"
          ]
        },
        "marital_status": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "Single",
            "Married",
            "Widowed",
            "Divorced",
            null
          ]
        },
        "birth_month": {
          "type": [
            "string",
            "null"
          ]
        },
        "birth_year": {
          "type": [
            "integer",
            "null"
          ]
        },
        "birthplace": {
          "type": [
            "object",
            "null"
          ],
          "$ref": "_shared_defs.schema.json#/$defs/location"
        },
        "father_birthplace": {
          "type": [
            "object",
            "null"
          ],
          "$ref": "_shared_defs.schema.json#/$defs/location"
        },
        "mother_birthplace": {
          "type": [
            "object",
            "null"
          ],
          "$ref": "_shared_defs.schema.json#/$defs/location"
        },
        "occupation": {
          "type": "object",
          "unevaluatedProperties": false,
          "properties": {
            "trade": {
              "type": [
                "string",
                "null"
              ]
            },
            "industry": {
              "type": [
                "string",
                "null"
              ]
            },
            "class_of_worker": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "real_estate_value": {
          "type": [
            "string",
            "null"
          ]
        },
        "personal_estate_value": {
          "type": [
            "string",
            "null"
          ]
        },
        "immigration_year": {
          "type": [
            "integer",
            "null"
          ]
        },
        "naturalization_status": {
          "type": [
            "string",
            "null"
          ],
          "description": "Recorded naturalization status (e.g., 'Al', 'Pa', 'Na', 'Yes', 'No')."
        },
        "can_read": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "can_write": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "attended_school": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "years_married": {
          "type": [
            "integer",
            "null"
          ]
        },
        "children_born": {
          "type": [
            "integer",
            "null"
          ]
        },
        "children_living": {
          "type": [
            "integer",
            "null"
          ]
        },
        "home_owned_or_rented": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "Owned",
            "Rented",
            "Free",
            "Mortgaged",
            null
          ]
        }
      }
    },
    "census_line_entry": {
      "type": "object",
      "unevaluatedProperties": false,
      "required": [
        "line_guid",
        "line_urn",
        "line_number",
        "name"
      ],
      "properties": {
        "line_guid": {
          "$ref": "_shared_defs.schema.json#/$defs/fact_id",
          "description": "Canonical UUID uniquely identifying this individual census line entry."
        },
        "line_urn": {
          "type": "string",
          "pattern": "^URN:CENSUS:[0-9]{4}:(?:[A-Z0-9_]+:)*[A-Za-z0-9_-]+:LINE:\\d+$"
        },
        "line_number": {
          "type": "integer",
          "minimum": 1
        },
        "family_number": {
          "type": [
            "string",
            "null"
          ]
        },
        "dwelling_number": {
          "type": [
            "string",
            "null"
          ]
        },
        "person_id": {
          "$ref": "_shared_defs.schema.json#/$defs/person_id"
        },
        "name": {
          "$ref": "_shared_defs.schema.json#/$defs/canonical_name"
        },
        "individual_data": {
          "$ref": "#/$defs/population_individual_particulars"
        },
        "tally_brackets": {
          "oneOf": [
            {
              "$ref": "#/$defs/census_1790_particulars"
            },
            {
              "$ref": "#/$defs/census_1800_1810_particulars"
            },
            {
              "$ref": "#/$defs/census_1820_particulars"
            },
            {
              "$ref": "#/$defs/census_1830_1840_particulars"
            },
            {
              "type": "null"
            }
          ]
        },
        "line_note": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}