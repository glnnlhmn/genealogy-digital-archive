{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://genealogy.archive/schemas/defs/_external_xref_defs.schema.json",
  "title": "Genealogy_External_Xref_Definitions",
  "version": "1.0.0",
  "description": "Cross-reference containers mapping internal entities to external software pointers and GEDCOM records.",
  "$defs": {
    "external_identifiers": {
      "type": "object",
      "description": "Cross-reference container mapping internal IND-##### persons to external software pointers.",
      "unevaluatedProperties": false,
      "properties": {
        "gedcom_xref": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^@I[A-Za-z0-9_]+@$"
        },
        "gedcom_uid": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^([0-9A-Fa-f]{32}|[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$"
        },
        "gedcom_refn": {
          "type": [
            "string",
            "null"
          ]
        },
        "familysearch_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Z0-9]{4}-[A-Z0-9]{3,4}$"
        }
      }
    },
    "fact_external_identifiers": {
      "type": "object",
      "description": "Cross-reference container mapping internal fact assertions to external GEDCOM event records.",
      "unevaluatedProperties": false,
      "properties": {
        "gedcom_tag": {
          "type": [
            "string",
            "null"
          ]
        },
        "gedcom_uid": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^([0-9A-Fa-f]{32}|[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$"
        },
        "source_xref": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^@S[A-Za-z0-9_]+@$"
        }
      }
    }
  }
}