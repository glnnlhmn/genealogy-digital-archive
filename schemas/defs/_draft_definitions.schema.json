{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://genealogy.archive/schemas/defs/_draft_definitions.schema.json",
  "title": "Draft_Registration_Definitions",
  "version": "1.0.0",
  "description": "Conflict- and era-specific registration containers and particulars for historical military draft enrollments.",
  "$defs": {
    "civil_war_particulars": {
      "type": "object",
      "description": "Enrollment particulars specific to the U.S. Civil War Enrollment Act of 1863.",
      "properties": {
        "enrollment_class": {
          "type": "string",
          "enum": ["Class 1", "Class 2", "Volunteers", null],
          "description": "Class 1: unmarried 20-45 or married 20-35; Class 2: married 35-45."
        },
        "former_military_service": {
          "type": ["string", "null"],
          "description": "Prior regiment, company, or service recorded on the roll."
        },
        "marital_status": {
          "type": ["string", "null"],
          "enum": ["Single", "Married", "Widowed", "Divorced", null]
        }
      },
      "additionalProperties": false
    },
    "wwi_particulars": {
      "type": "object",
      "description": "Registration particulars specific to WWI Draft Registrations (1917–1918).",
      "properties": {
        "registration_card_type": {
          "type": "string",
          "enum": ["Card A (1917)", "Card B (1918)", "Card C (1918)", null]
        },
        "serial_number": { "type": ["string", "null"] },
        "order_number": { "type": ["string", "null"] },
        "citizenship_status": {
          "type": ["string", "null"],
          "enum": ["Native Born", "Naturalized", "Alien", "Declarant", "Non-Declarant", null]
        },
        "father_birthplace": {
          "oneOf": [
            { "$ref": "_shared_definitions.schema.json#/$defs/location" },
            { "type": "null" }
          ]
        },
        "nearest_relative": {
          "type": "object",
          "properties": {
            "name": { "type": ["string", "null"] },
            "relationship": { "type": ["string", "null"] },
            "address": {
              "oneOf": [
                { "$ref": "_shared_definitions.schema.json#/$defs/location" },
                { "type": "null" }
              ]
            }
          },
          "additionalProperties": false
        },
        "employer": {
          "type": "object",
          "properties": {
            "name": { "type": ["string", "null"] },
            "work_location": {
              "oneOf": [
                { "$ref": "_shared_definitions.schema.json#/$defs/location" },
                { "type": "null" }
              ]
            }
          },
          "additionalProperties": false
        },
        "exemption_claimed": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "wwii_particulars": {
      "type": "object",
      "description": "Registration particulars specific to WWII Draft Registrations (1940–1946, including the 4th Registration / Old Man's Draft).",
      "properties": {
        "registration_round": {
          "type": "string",
          "description": "e.g., 'Fourth Registration (Old Man's Draft)', 'First Registration (1940)'."
        },
        "serial_number": { "type": ["string", "null"] },
        "order_number": { "type": ["string", "null"] },
        "telephone_number": { "type": ["string", "null"] },
        "person_who_will_always_know_address": {
          "type": "object",
          "properties": {
            "name": { "type": ["string", "null"] },
            "relationship": { "type": ["string", "null"] },
            "address": {
              "oneOf": [
                { "$ref": "_shared_definitions.schema.json#/$defs/location" },
                { "type": "null" }
              ]
            }
          },
          "additionalProperties": false
        },
        "employer": {
          "type": "object",
          "properties": {
            "name": { "type": ["string", "null"] },
            "place_of_employment": {
              "oneOf": [
                { "$ref": "_shared_definitions.schema.json#/$defs/location" },
                { "type": "null" }
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "selective_service_modern_particulars": {
      "type": "object",
      "description": "Particulars for Cold War Peacetime (1948-1950), Korean War (1950-1953), and Vietnam Era (1964-1973) registrations (SSS Form 1 / SSS Form 2).",
      "properties": {
        "selective_service_number": {
          "type": ["string", "null"],
          "description": "Standardized SSS number format (State - Board - Year - Sequence, e.g., 36-021-31-104)."
        },
        "classification_status": {
          "type": ["string", "null"],
          "description": "Selective Service classification (e.g., 1-A, 1-D, 2-S Student Deferment, 3-A Hardship, 4-F)."
        },
        "lottery_sequence_number": {
          "type": ["integer", "null"],
          "description": "Vietnam draft lottery sequence draw number (1-366)."
        },
        "marital_status": {
          "type": ["string", "null"],
          "enum": ["Single", "Married", "Divorced", "Widowed", null]
        },
        "number_of_dependents": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "person_who_will_always_know_address": {
          "type": "object",
          "properties": {
            "name": { "type": ["string", "null"] },
            "relationship": { "type": ["string", "null"] },
            "address": {
              "oneOf": [
                { "$ref": "_shared_definitions.schema.json#/$defs/location" },
                { "type": "null" }
              ]
            }
          },
          "additionalProperties": false
        },
        "employer_or_school": {
          "type": "object",
          "properties": {
            "institution_name": { "type": ["string", "null"] },
            "location": {
              "oneOf": [
                { "$ref": "_shared_definitions.schema.json#/$defs/location" },
                { "type": "null" }
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "generic_draft_particulars": {
      "type": "object",
      "description": "Flexible container for state militia enrollments, Spanish-American War, or unlisted peacetime conscriptions.",
      "properties": {
        "conscription_act": { "type": ["string", "null"] },
        "militia_district_or_ward": { "type": ["string", "null"] },
        "exemptions_claimed": { "type": ["string", "null"] },
        "prior_service_notes": { "type": ["string", "null"] },
        "schedule_fields": {
          "type": "object",
          "additionalProperties": { "type": "string" },
          "description": "Key-value pairs for non-standard local enrollment columns."
        }
      },
      "additionalProperties": false
    },
    "physical_description": {
      "type": "object",
      "description": "Physical characteristics recorded by the registrar.",
      "properties": {
        "race_or_color": { "type": ["string", "null"] },
        "height": { "type": ["string", "null"] },
        "weight": { "type": ["string", "null"] },
        "build": { "type": ["string", "null"] },
        "eyes_color": { "type": ["string", "null"] },
        "hair_color": { "type": ["string", "null"] },
        "complexion": { "type": ["string", "null"] },
        "physical_disabilities_or_marks": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    }
  }
}