{
  "_name": "_shared_defs.schema.json",
  "_path": "schemas/defs/_shared_defs.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://genealogy.archive/schemas/defs/_shared_defs.schema.json",
  "title": "Shared Data Definitions",
  "$defs": {
    "location_id": {
      "type": "string",
      "pattern": "^LOC-[0-9]{5}$",
      "description": "Standardized canonical location identifier format."
    },
    "enum_location_type": {
      "type": "string",
      "enum": [
        "CIVIL_JURISDICTION",
        "FACILITY",
        "CEMETERY",
        "LANDMARK",
        "RESIDENCE",
        "CHURCH"
      ],
      "description": "Classification of the physical or administrative location entity."
    },
    "location_details": {
      "type": "object",
      "properties": {
        "location_name": {
          "type": [
            "string",
            "null"
          ],
          "description": "Specific facility, hospital, church, cemetery, or landmark name."
        },
        "address_line_1": {
          "type": [
            "string",
            "null"
          ]
        },
        "address_line_2": {
          "type": [
            "string",
            "null"
          ]
        },
        "local_jurisdiction": {
          "type": [
            "string",
            "null"
          ],
          "description": "Township, borough, town, or city."
        },
        "county": {
          "type": [
            "string",
            "null"
          ]
        },
        "state_or_province": {
          "type": [
            "string",
            "null"
          ]
        },
        "country": {
          "type": [
            "string",
            "null"
          ]
        },
        "postal_code": {
          "type": [
            "string",
            "null"
          ]
        },
        "coordinates": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "latitude": {
              "type": "number"
            },
            "longitude": {
              "type": "number"
            }
          },
          "required": [
            "latitude",
            "longitude"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "location": {
      "type": "object",
      "description": "Standard location reference object used across people, facts, and master location records.",
      "properties": {
        "location_id": {
          "$ref": "#/$defs/location_id",
          "description": "Optional foreign key pointer to canonical record in locations.json."
        },
        "verbatim": {
          "type": "string",
          "description": "Raw unstandardized text as extracted from primary documentation."
        },
        "standardized": {
          "type": "string",
          "description": "Normalized civil jurisdiction string: [Jurisdiction, County, State, Country]. Never contains specific facility/landmark names."
        },
        "details": {
          "$ref": "#/$defs/location_details"
        }
      },
      "required": [
        "standardized"
      ],
      "additionalProperties": false
    },
    "note_entry": {
      "type": "object",
      "required": [
        "note_id",
        "category",
        "text"
      ],
      "properties": {
        "note_id": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "text": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}