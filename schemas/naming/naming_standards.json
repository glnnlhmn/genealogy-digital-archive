{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "name": "naming_standards.json",
  "version": "1.0.15",
  "description": "Deterministic file naming specifications and pattern templates for the digital archive.",
  "token_registry_ref": "schemas/naming/_token_registry.json",
