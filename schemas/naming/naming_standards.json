    "census": {
      "record_type": "CENSUS",
      "pattern": "[YEAR]_CENSUS_[REGION_1]_[REGION_2]_[JURISDICTION]_[LOCATOR_CENSUS].[ext]",
      "components": {
        "YEAR": { "type": "regex", "pattern": "^(1790|18[0-9]{2}|19[0-5]{1}[0-9]{1})$" },
        "RECORD_TYPE": { "type": "literal", "value": "CENSUS" },
        "REGION_1": { "type": "registry_ref", "path": "states" },
        "REGION_2": { "type": "registry_ref", "path": "counties" },
        "JURISDICTION": { "type": "registry_ref", "path": "jurisdictions" },
        "LOCATOR_CENSUS": { "type": "registry_ref", "path": "locator_census_patterns" }
      },
      "examples": [
        "1840_CENSUS_PA_Cumberland_WestPennsboro_P070.json",
        "1850_CENSUS_PA_Cumberland_WestPennsboro_P140S070B.json",
        "1900_CENSUS_PA_Cumberland_Frankford_ED10S08A.json",
        "1940_CENSUS_PA_Cumberland_LowerFrankford_ED21-27S05A.json"
      ]
    },
