{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://genealogy.archive/schemas/sources/tax_assessment.schema.json",
  "title": "TaxAssessmentRecord",
  "version": "1.0.0",
  "description": "Standardized schema for historical county and township real estate, personal property, poll, and septennial tax lists.",
  "type": "object",
  "required": [
    "$schema",
    "description",
    "record_metadata",
    "assessment_jurisdiction",
    "tax_details",
    "associated_people"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "description": {
      "type": "string",
      "description": "[REQUIRED] Contextual summary (e.g., '1855 County Tax Assessment of Christian Lehman (West Pennsboro Twp, Cumberland Co., PA)')."
    },
    "record_metadata": {
      "type": "object",
      "required": ["source_urn", "record_category", "record_type"],
      "properties": {
        "source_urn": {
          "type": "string",
          "pattern": "^URN:TAX:[0-9]{4}:[A-Z0-9_]+:[A-Za-z0-9_-]+$",
          "description": "Adheres to URN:TAX:[YEAR]:[JURISDICTION]:[LOCATOR]."
        },
        "record_category": {
          "type": "string",
          "enum": ["TAX", "FISCAL", "CENSUS_EQUIVALENT"],
          "default": "TAX"
        },
        "record_type": {
          "type": "string",
          "enum": [
            "REAL_ESTATE_TAX",
            "PERSONAL_PROPERTY_TAX",
            "POLL_TAX",
            "SEPTENNIAL_CENSUS",
            "OCCUPATION_TAX",
            "FREEMEN_LIST",
            "EXONERATION_LIST"
          ],
          "default": "REAL_ESTATE_TAX"
        }
      },
      "additionalProperties": false
    },
    "assessment_jurisdiction": {
      "type": "object",
      "required": ["assessment_year", "taxing_district"],
      "properties": {
        "assessment_year": {
          "type": "integer",
          "minimum": 1600,
          "maximum": 2100
        },
        "taxing_district": {
          "$ref": "../defs/_shared_definitions.schema.json#/$defs/location",
          "description": "Township, borough, ward, or county collecting the assessment."
        },
        "assessor_name": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "tax_details": {
      "type": "object",
      "required": [
        "roll_reference",
        "taxpayer",
        "transcript",
        "media_files"
      ],
      "properties": {
        "roll_reference": {
          "type": "object",
          "required": ["locator"],
          "properties": {
            "locator": {
              "type": "string",
              "description": "Page number, line item, or assessment entry matching locator_tax_patterns."
            },
            "schedule_name": {
              "type": ["string", "null"],
              "description": "e.g., 'Seated Land List', 'Unseated Land', 'Freemen List', 'Inhabitants'."
            },
            "line_number": { "type": ["integer", "null"] }
          },
          "additionalProperties": false
        },
        "taxpayer": {
          "type": "object",
          "required": ["full_name"],
          "properties": {
            "person_id": {
              "$ref": "../defs/_shared_definitions.schema.json#/$defs/person_id"
            },
            "full_name": {
              "$ref": "../defs/_shared_definitions.schema.json#/$defs/canonical_name"
            },
            "classification": {
              "type": ["string", "null"],
              "enum": ["Freeholder", "Tenant", "Single Freeman", "Inmate", "Widow", null],
              "description": "Status recorded on the historical roll."
            },
            "stated_occupation": { "type": ["string", "null"] }
          },
          "additionalProperties": false
        },
        "assessed_property": {
          "type": "object",
          "properties": {
            "acres_seated": { "type": ["number", "null"] },
            "acres_unseated": { "type": ["number", "null"] },
            "horses": { "type": ["integer", "null"] },
            "cattle_or_cows": { "type": ["integer", "null"] },
            "mills_distilleries_taverns": { "type": ["string", "null"] },
            "total_valuation": { "type": ["string", "null"] },
            "county_tax_amount": { "type": ["string", "null"] },
            "state_tax_amount": { "type": ["string", "null"] }
          },
          "additionalProperties": false
        },
        "tax_note": {
          "type": ["string", "null"],
          "description": "Marginal notations, exonerations, or marks (e.g., 'transferred to John Doe')."
        },
        "transcript": {
          "$ref": "../defs/_shared_definitions.schema.json#/$defs/transcript_record",
          "description": "Verbatim line readout, abstract, and keywords."
        },
        "media_files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "../defs/_shared_definitions.schema.json#/$defs/source_media"
          },
          "description": "Image scans of the tax ledger folio."
        }
      },
      "additionalProperties": false
    },
    "associated_people": {
      "type": "array",
      "items": {
        "$ref": "../defs/_shared_definitions.schema.json#/$defs/associated_person_entry"
      },
      "description": "Array of participants (taxpayer, landlord if tenant, assessor) mapped to roles and IDs."
    }
  },
  "additionalProperties": false
}