{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://genealogy.archive/schemas/sources/directory_listing.schema.json",
  "title": "DirectoryListingRecord",
  "version": "1.0.1",
  "description": "Standardized schema for historical city directories, telephone books, trade directories, and street gazetteers.",
  "type": "object",
  "required": [
    "$schema",
    "description",
    "record_metadata",
    "directory_publication",
    "listing_details",
    "associated_people"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "description": {
      "type": "string",
      "description": "[REQUIRED] Contextual summary (e.g., '1924 City Directory Entry for William Lehman (Carlisle, PA)')."
    },
    "record_metadata": {
      "type": "object",
      "required": ["source_urn", "record_category", "record_type"],
      "properties": {
        "source_urn": {
          "type": "string",
          "pattern": "^URN:DIRECTORY:[0-9]{4}:[A-Z0-9_]+:[A-Za-z0-9_-]+$",
          "description": "Adheres to URN:DIRECTORY:[YEAR]:[JURISDICTION]:[LOCATOR]."
        },
        "record_category": {
          "type": "string",
          "enum": ["DIRECTORY"],
          "default": "DIRECTORY"
        },
        "record_type": {
          "type": "string",
          "enum": [
            "CITY_DIRECTORY",
            "TELEPHONE_DIRECTORY",
            "BUSINESS_DIRECTORY",
            "FARMERS_DIRECTORY",
            "STREET_GAZETTEER"
          ],
          "default": "CITY_DIRECTORY"
        }
      },
      "additionalProperties": false
    },
    "directory_publication": {
      "type": "object",
      "required": ["title", "publication_year", "coverage_area"],
      "properties": {
        "title": {
          "type": "string",
          "description": "e.g., 'Carlisle Directory 1924-1925', 'Boyd's Directory of Harrisburg'."
        },
        "publisher": { "type": ["string", "null"] },
        "publication_year": {
          "type": "integer",
          "minimum": 1600,
          "maximum": 2100
        },
        "coverage_area": {
          "$ref": "../defs/_shared_definitions.schema.json#/$defs/location"
        }
      },
      "additionalProperties": false
    },
    "listing_details": {
      "type": "object",
      "required": [
        "listing_reference",
        "primary_listed_individual",
        "transcript",
        "media_files"
      ],
      "properties": {
        "listing_reference": {
          "type": "object",
          "required": ["locator"],
          "properties": {
            "locator": {
              "type": "string",
              "description": "Page and column matching locator_directory_patterns."
            },
            "page_number": { "type": ["string", "null"] },
            "column": { "type": ["string", "null"] }
          },
          "additionalProperties": false
        },
        "primary_listed_individual": {
          "type": "object",
          "required": ["full_name"],
          "properties": {
            "person_id": {
              "$ref": "../defs/_shared_definitions.schema.json#/$defs/person_id"
            },
            "full_name": {
              "$ref": "../defs/_shared_definitions.schema.json#/$defs/canonical_name"
            },
            "stated_occupation": { "type": ["string", "null"] },
            "employer_or_business": { "type": ["string", "null"] },
            "residential_address": {
              "oneOf": [
                { "$ref": "../defs/_shared_definitions.schema.json#/$defs/location" },
                { "type": "null" }
              ]
            },
            "residential_status": {
              "type": ["string", "null"],
              "enum": ["Householder", "Boarder", "Rooms", "Tenant", "Widow", null],
              "description": "Notation code used in directory (e.g., 'h', 'bds', 'rms')."
            }
          },
          "additionalProperties": false
        },
        "listing_note": {
          "type": ["string", "null"],
          "description": "Notes on business advertisements or marginal notations."
        },
        "transcript": {
          "$ref": "../defs/_shared_definitions.schema.json#/$defs/transcript_record"
        },
        "media_files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "../defs/_shared_definitions.schema.json#/$defs/source_media"
          }
        }
      },
      "additionalProperties": false
    },
    "associated_people": {
      "type": "array",
      "items": {
        "$ref": "../defs/_shared_definitions.schema.json#/$defs/associated_person_entry"
      },
      "description": "Array of participants (listed subject, spouse noted in parentheses, deceased husband if listed as 'widow of') mapped to roles and IDs."
    }
  },
  "additionalProperties": false
}