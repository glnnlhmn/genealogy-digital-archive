{
  "_name": "immigration_manifest.schema.json",
  "_path": "schemas/sources/immigration_manifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://genealogy.archive/schemas/sources/immigration_manifest.schema.json",
  "title": "ImmigrationManifestRecord",
  "version": "1.0.0",
  "description": "Standardized schema for historical ship passenger arrival manifests, border inspection cards, customs lists, and oaths of allegiance.",
  "type": "object",
  "required": [
    "_name",
    "_path",
    "$schema",
    "description",
    "record_metadata",
    "voyage",
    "manifest_details",
    "associated_people"
  ],
  "properties": {
    "_name": {
      "type": "string"
    },
    "_path": {
      "type": "string"
    },
    "$schema": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "description": "Contextual summary of the immigration manifest record."
    },
    "record_metadata": {
      "type": "object",
      "required": [
        "source_urn",
        "record_category",
        "record_type"
      ],
      "properties": {
        "source_urn": {
          "type": "string",
          "pattern": "^URN:IMMIGRATION:[0-9]{4}:[A-Z0-9_]+:[A-Za-z0-9_-]+$",
          "description": "Adheres to URN:IMMIGRATION:[YEAR]:[JURISDICTION]:[LOCATOR]."
        },
        "record_category": {
          "type": "string",
          "enum": [
            "IMMIGRATION",
            "TRAVEL",
            "CUSTOMS"
          ],
          "default": "IMMIGRATION"
        },
        "record_type": {
          "type": "string",
          "enum": [
            "PASSENGER_MANIFEST",
            "CUSTOMS_LIST",
            "OATH_OF_ALLEGIANCE_LIST",
            "BORDER_CROSSING_CARD",
            "CREW_LIST"
          ],
          "default": "PASSENGER_MANIFEST"
        }
      },
      "additionalProperties": false
    },
    "voyage": {
      "type": "object",
      "required": [
        "port_of_arrival",
        "arrival_date"
      ],
      "properties": {
        "ship_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "master_or_captain": {
          "type": [
            "string",
            "null"
          ]
        },
        "shipping_line": {
          "type": [
            "string",
            "null"
          ]
        },
        "port_of_departure": {
          "oneOf": [
            {
              "$ref": "../defs/_shared_defs.schema.json#/$defs/location"
            },
            {
              "type": "null"
            }
          ]
        },
        "port_of_arrival": {
          "$ref": "../defs/_shared_defs.schema.json#/$defs/location"
        },
        "arrival_date": {
          "$ref": "../defs/_shared_defs.schema.json#/$defs/date_interpreted"
        }
      },
      "additionalProperties": false
    },
    "manifest_details": {
      "type": "object",
      "required": [
        "manifest_reference",
        "passenger",
        "transcript",
        "media_files"
      ],
      "properties": {
        "manifest_reference": {
          "type": "object",
          "required": [
            "locator"
          ],
          "properties": {
            "locator": {
              "type": "string"
            },
            "list_number": {
              "type": [
                "string",
                "null"
              ]
            },
            "line_number": {
              "type": [
                "integer",
                "null"
              ]
            }
          },
          "additionalProperties": false
        },
        "passenger": {
          "type": "object",
          "required": [
            "full_name"
          ],
          "properties": {
            "person_id": {
              "$ref": "../defs/_shared_defs.schema.json#/$defs/person_id"
            },
            "full_name": {
              "$ref": "../defs/_shared_defs.schema.json#/$defs/canonical_name"
            },
            "age": {
              "oneOf": [
                {
                  "$ref": "../defs/_shared_defs.schema.json#/$defs/age_record"
                },
                {
                  "type": "null"
                }
              ]
            },
            "sex": {
              "type": [
                "string",
                "null"
              ],
              "enum": [
                "Male",
                "Female",
                "Unknown",
                null
              ]
            },
            "marital_status": {
              "type": [
                "string",
                "null"
              ],
              "enum": [
                "Single",
                "Married",
                "Widowed",
                "Divorced",
                null
              ]
            },
            "occupation": {
              "type": [
                "string",
                "null"
              ]
            },
            "last_permanent_residence": {
              "oneOf": [
                {
                  "$ref": "../defs/_shared_defs.schema.json#/$defs/location"
                },
                {
                  "type": "null"
                }
              ]
            },
            "final_destination": {
              "oneOf": [
                {
                  "$ref": "../defs/_shared_defs.schema.json#/$defs/location"
                },
                {
                  "type": "null"
                }
              ]
            },
            "relative_joined": {
              "type": "object",
              "properties": {
                "name": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "relationship": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "address": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "manifest_note": {
          "type": [
            "string",
            "null"
          ]
        },
        "transcript": {
          "$ref": "../defs/_shared_defs.schema.json#/$defs/transcript_record"
        },
        "media_files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "../defs/_shared_defs.schema.json#/$defs/source_media"
          }
        }
      },
      "additionalProperties": false
    },
    "associated_people": {
      "type": "array",
      "items": {
        "$ref": "../defs/_shared_defs.schema.json#/$defs/associated_person_entry"
      }
    }
  },
  "additionalProperties": false
}
