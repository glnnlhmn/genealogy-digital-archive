{
  "_name": "military_draft.schema.json",
  "_path": "schemas/sources/military_draft.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://genealogy.archive/schemas/sources/military_draft.schema.json",
  "title": "MilitaryDraftRecord",
  "version": "1.0.1",
  "description": "Standardized schema for historical military draft registrations, enrollments, and conscription records.",
  "type": "object",
  "required": [
    "_name",
    "_path",
    "$schema",
    "description",
    "record_metadata",
    "draft_board",
    "draft_details",
    "associated_people"
  ],
  "properties": {
    "_name": {
      "type": "string"
    },
    "_path": {
      "type": "string"
    },
    "$schema": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "description": "Contextual summary of this military draft record."
    },
    "record_metadata": {
      "type": "object",
      "required": [
        "source_urn",
        "record_category",
        "record_type",
        "conflict"
      ],
      "properties": {
        "source_urn": {
          "type": "string",
          "pattern": "^URN:DRAFT:[0-9]{4}:[A-Z0-9_]+:[A-Za-z0-9_-]+$",
          "description": "Adheres to URN:DRAFT:[YEAR]:[JURISDICTION]:[LOCATOR]."
        },
        "record_category": {
          "type": "string",
          "enum": [
            "MILITARY"
          ],
          "default": "MILITARY"
        },
        "record_type": {
          "type": "string",
          "enum": [
            "DRAFT_REGISTRATION",
            "ENROLLMENT_LIST",
            "CONSCRIPTION_CARD"
          ],
          "default": "DRAFT_REGISTRATION"
        },
        "conflict": {
          "type": "string",
          "enum": [
            "CW",
            "SPANAM",
            "WWI",
            "WWII",
            "KOREA",
            "VIETNAM",
            "PEACETIME"
          ]
        }
      },
      "additionalProperties": false
    },
    "draft_board": {
      "type": "object",
      "required": [
        "board_identifier",
        "location"
      ],
      "properties": {
        "board_identifier": {
          "type": "string"
        },
        "location": {
          "$ref": "../defs/_shared_defs.schema.json#/$defs/location"
        },
        "registration_date": {
          "oneOf": [
            {
              "$ref": "../defs/_shared_defs.schema.json#/$defs/date_interpreted"
            },
            {
              "type": "null"
            }
          ]
        },
        "registrar_signature": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "draft_details": {
      "type": "object",
      "required": [
        "registrant",
        "transcript",
        "media_files"
      ],
      "properties": {
        "registrant": {
          "type": "object",
          "required": [
            "full_name"
          ],
          "properties": {
            "person_id": {
              "$ref": "../defs/_shared_defs.schema.json#/$defs/person_id"
            },
            "full_name": {
              "$ref": "../defs/_shared_defs.schema.json#/$defs/canonical_name"
            },
            "residence": {
              "oneOf": [
                {
                  "$ref": "../defs/_shared_defs.schema.json#/$defs/location"
                },
                {
                  "type": "null"
                }
              ]
            },
            "date_of_birth": {
              "oneOf": [
                {
                  "$ref": "../defs/_shared_defs.schema.json#/$defs/date_interpreted"
                },
                {
                  "type": "null"
                }
              ]
            },
            "age": {
              "oneOf": [
                {
                  "$ref": "../defs/_shared_defs.schema.json#/$defs/age_record"
                },
                {
                  "type": "null"
                }
              ]
            },
            "birthplace": {
              "oneOf": [
                {
                  "$ref": "../defs/_shared_defs.schema.json#/$defs/location"
                },
                {
                  "type": "null"
                }
              ]
            },
            "occupation": {
              "type": "object",
              "properties": {
                "usual": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "industry": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "conflict_particulars": {
          "oneOf": [
            {
              "$ref": "../defs/_military_defs.schema.json#/$defs/wwi_particulars"
            },
            {
              "$ref": "../defs/_military_defs.schema.json#/$defs/selective_service_record"
            },
            {
              "type": "null"
            }
          ]
        },
        "draft_note": {
          "type": [
            "string",
            "null"
          ]
        },
        "transcript": {
          "$ref": "../defs/_shared_defs.schema.json#/$defs/transcript_record"
        },
        "media_files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "../defs/_shared_defs.schema.json#/$defs/source_media"
          }
        }
      },
      "additionalProperties": false
    },
    "associated_people": {
      "type": "array",
      "items": {
        "$ref": "../defs/_shared_defs.schema.json#/$defs/associated_person_entry"
      }
    }
  },
  "additionalProperties": false
}
