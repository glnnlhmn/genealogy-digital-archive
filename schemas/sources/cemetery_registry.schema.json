{
  "_name": "cemetery_registry.schema.json",
  "_path": "schemas/sources/cemetery_registry.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://genealogy.archive/schemas/sources/cemetery_registry.schema.json",
  "title": "CemeteryRegistryRecord",
  "version": "1.0.0",
  "description": "Standardized registry capturing cemetery plot ledgers, sexton books, and grave surveys.",
  "type": "object",
  "required": [
    "_name",
    "_path",
    "$schema",
    "version",
    "last_updated",
    "site_id",
    "cemetery_name",
    "location",
    "plots"
  ],
  "properties": {
    "_name": {
      "type": "string"
    },
    "_path": {
      "type": "string"
    },
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "last_updated": {
      "$ref": "../defs/_shared_defs.schema.json#/$defs/timestamp_iso"
    },
    "site_id": {
      "$ref": "../defs/_shared_defs.schema.json#/$defs/site_id",
      "description": "Foreign key reference to physical site in sites.json."
    },
    "cemetery_name": {
      "type": "string"
    },
    "location": {
      "$ref": "../defs/_shared_defs.schema.json#/$defs/location"
    },
    "sexton_or_custodian": {
      "type": [
        "string",
        "null"
      ]
    },
    "survey_date": {
      "oneOf": [
        {
          "$ref": "../defs/_shared_defs.schema.json#/$defs/date_interpreted"
        },
        {
          "type": "null"
        }
      ]
    },
    "plots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "plot_locator",
          "interments"
        ],
        "properties": {
          "plot_locator": {
            "type": "string",
            "description": "Lot, Section, Row, or Tomb coordinate."
          },
          "marker_urn": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^URN:CEMETERY:[0-9]{4}:[A-Z0-9_]+:[A-Za-z0-9_-]+$",
            "description": "Optional link to detailed cemetery_marker source record."
          },
          "condition": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "Sound",
              "Weathered",
              "Broken",
              "Sunken",
              "Illegible",
              "Overgrown",
              null
            ]
          },
          "interments": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "inscribed_name"
              ],
              "properties": {
                "person_id": {
                  "oneOf": [
                    {
                      "$ref": "../defs/_shared_defs.schema.json#/$defs/person_id"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "inscribed_name": {
                  "$ref": "../defs/_shared_defs.schema.json#/$defs/canonical_name"
                },
                "birth_year": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "death_year": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "age_inscribed": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "relationship_text": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
