{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://genealogy.archive/schemas/sources/probate_record.schema.json",
  "title": "ProbateRecord",
  "version": "1.0.0",
  "description": "Standardized schema for historical last wills and testaments, estate administrations, inventories, Orphans' Court entries, and accountings.",
  "type": "object",
  "required": [
    "$schema",
    "description",
    "record_metadata",
    "court",
    "probate_details",
    "associated_people"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "description": {
      "type": "string",
      "description": "[REQUIRED] Contextual summary (e.g., '1874 Will of Christian Lehman (Carlisle, Cumberland Co., PA)')."
    },
    "record_metadata": {
      "type": "object",
      "required": ["source_urn", "record_category", "record_type"],
      "properties": {
        "source_urn": {
          "type": "string",
          "pattern": "^URN:WILL:[0-9]{4}:[A-Z0-9_]+:[A-Za-z0-9_-]+$",
          "description": "Adheres to URN:WILL:[YEAR]:[JURISDICTION]:[LOCATOR]."
        },
        "record_category": {
          "type": "string",
          "enum": ["PROBATE", "LEGAL"],
          "default": "PROBATE"
        },
        "record_type": {
          "type": "string",
          "enum": [
            "LAST_WILL_AND_TESTAMENT",
            "LETTERS_ADMINISTRATION",
            "LETTERS_TESTAMENTARY",
            "ESTATE_INVENTORY",
            "ORPHANS_COURT_ENTRY",
            "ADMINISTRATION_ACCOUNT",
            "CODICIL"
          ],
          "default": "LAST_WILL_AND_TESTAMENT"
        }
      },
      "additionalProperties": false
    },
    "court": {
      "type": "object",
      "required": ["court_name", "location"],
      "properties": {
        "court_name": {
          "type": "string",
          "description": "Name of probate jurisdiction (e.g., 'Orphans Court of Cumberland County', 'Register of Wills')."
        },
        "location": {
          "$ref": "../defs/_shared_definitions.schema.json#/$defs/location",
          "description": "Jurisdiction where the court sits."
        },
        "register_or_clerk": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "probate_details": {
      "type": "object",
      "required": [
        "filing_reference",
        "decedent",
        "transcript",
        "media_files"
      ],
      "properties": {
        "filing_reference": {
          "type": "object",
          "required": ["locator"],
          "properties": {
            "locator": {
              "type": "string",
              "description": "Will book and page, estate file number, or docket entry matching locator_will_patterns."
            },
            "estate_file_number": { "type": ["string", "null"] },
            "book_and_page": { "type": ["string", "null"] },
            "docket_term": { "type": ["string", "null"] }
          },
          "additionalProperties": false
        },
        "decedent": {
          "type": "object",
          "required": ["full_name"],
          "properties": {
            "person_id": {
              "$ref": "../defs/_shared_definitions.schema.json#/$defs/person_id",
              "description": "Foreign key pointing to the master Person Registry."
            },
            "full_name": {
              "$ref": "../defs/_shared_definitions.schema.json#/$defs/canonical_name"
            },
            "residence": {
              "oneOf": [
                { "$ref": "../defs/_shared_definitions.schema.json#/$defs/location" },
                { "type": "null" }
              ]
            },
            "condition_or_trade": {
              "type": ["string", "null"],
              "description": "e.g., 'Yeoman', 'Blacksmith', 'Intestate'."
            }
          },
          "additionalProperties": false
        },
        "dates": {
          "type": "object",
          "properties": {
            "date_written": {
              "oneOf": [
                { "$ref": "../defs/_shared_definitions.schema.json#/$defs/date_interpreted" },
                { "type": "null" }
              ],
              "description": "Date signed by testator (for wills/codicils)."
            },
            "date_probated": {
              "oneOf": [
                { "$ref": "../defs/_shared_definitions.schema.json#/$defs/date_interpreted" },
                { "type": "null" }
              ],
              "description": "Date proved before the register."
            },
            "date_letters_granted": {
              "oneOf": [
                { "$ref": "../defs/_shared_definitions.schema.json#/$defs/date_interpreted" },
                { "type": "null" }
              ],
              "description": "Date Letters of Administration or Testamentary were issued."
            },
            "date_appraised_or_accounted": {
              "oneOf": [
                { "$ref": "../defs/_shared_definitions.schema.json#/$defs/date_interpreted" },
                { "type": "null" }
              ],
              "description": "Date of inventory appraisal or final court accounting confirmation."
            }
          },
          "additionalProperties": false
        },
        "provisions_summary": {
          "type": ["string", "null"],
          "description": "Summary of devises, bequests, debts, bond amounts, or distribution balances."
        },
        "probate_note": {
          "type": ["string", "null"],
          "description": "Optional notes on caveat petitions, appraisals, or document condition."
        },
        "transcript": {
          "$ref": "../defs/_shared_definitions.schema.json#/$defs/transcript_record",
          "description": "Verbatim transcript, abstract summary, and keywords."
        },
        "media_files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "../defs/_shared_definitions.schema.json#/$defs/source_media"
          },
          "description": "Image scans of the original record leaves."
        }
      },
      "additionalProperties": false
    },
    "associated_people": {
      "type": "array",
      "items": {
        "$ref": "../defs/_shared_definitions.schema.json#/$defs/associated_person_entry"
      },
      "description": "Array of participants (decedent/testator, executors, administrators, appraisers, witnesses, beneficiaries) linked to standardized roles and IDs."
    }
  },
  "additionalProperties": false
}