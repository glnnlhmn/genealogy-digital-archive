{
  "_name": "probate_record.schema.json",
  "_path": "schemas/sources/probate_record.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://genealogy.archive/schemas/sources/probate_record.schema.json",
  "title": "ProbateRecord",
  "version": "1.0.0",
  "description": "Standardized schema for historical last wills and testaments, estate administrations, inventories, Orphans' Court entries, and accountings.",
  "type": "object",
  "required": [
    "_name",
    "_path",
    "$schema",
    "description",
    "record_metadata",
    "court",
    "probate_details",
    "associated_people"
  ],
  "properties": {
    "_name": {
      "type": "string"
    },
    "_path": {
      "type": "string"
    },
    "$schema": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "description": "Contextual summary of this probate source record."
    },
    "record_metadata": {
      "type": "object",
      "required": [
        "source_urn",
        "record_category",
        "record_type"
      ],
      "properties": {
        "source_urn": {
          "type": "string",
          "pattern": "^URN:WILL:[0-9]{4}:[A-Z0-9_]+:[A-Za-z0-9_-]+$",
          "description": "Adheres to URN:WILL:[YEAR]:[JURISDICTION]:[LOCATOR]."
        },
        "record_category": {
          "type": "string",
          "enum": [
            "PROBATE",
            "LEGAL"
          ],
          "default": "PROBATE"
        },
        "record_type": {
          "type": "string",
          "enum": [
            "LAST_WILL_AND_TESTAMENT",
            "LETTERS_ADMINISTRATION",
            "LETTERS_TESTAMENTARY",
            "ESTATE_INVENTORY",
            "ORPHANS_COURT_ENTRY",
            "ADMINISTRATION_ACCOUNT",
            "CODICIL"
          ],
          "default": "LAST_WILL_AND_TESTAMENT"
        }
      },
      "additionalProperties": false
    },
    "court": {
      "type": "object",
      "required": [
        "court_name",
        "location"
      ],
      "properties": {
        "court_name": {
          "type": "string"
        },
        "location": {
          "$ref": "../defs/_shared_defs.schema.json#/$defs/location"
        },
        "register_or_clerk": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "probate_details": {
      "type": "object",
      "required": [
        "filing_reference",
        "decedent",
        "transcript",
        "media_files"
      ],
      "properties": {
        "filing_reference": {
          "type": "object",
          "required": [
            "locator"
          ],
          "properties": {
            "locator": {
              "type": "string"
            },
            "estate_file_number": {
              "type": [
                "string",
                "null"
              ]
            },
            "book_and_page": {
              "type": [
                "string",
                "null"
              ]
            },
            "docket_term": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false
        },
        "decedent": {
          "type": "object",
          "required": [
            "full_name"
          ],
          "properties": {
            "person_id": {
              "$ref": "../defs/_shared_defs.schema.json#/$defs/person_id"
            },
            "full_name": {
              "$ref": "../defs/_shared_defs.schema.json#/$defs/canonical_name"
            },
            "residence": {
              "oneOf": [
                {
                  "$ref": "../defs/_shared_defs.schema.json#/$defs/location"
                },
                {
                  "type": "null"
                }
              ]
            },
            "condition_or_trade": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false
        },
        "dates": {
          "type": "object",
          "properties": {
            "date_written": {
              "oneOf": [
                {
                  "$ref": "../defs/_shared_defs.schema.json#/$defs/date_interpreted"
                },
                {
                  "type": "null"
                }
              ]
            },
            "date_probated": {
              "oneOf": [
                {
                  "$ref": "../defs/_shared_defs.schema.json#/$defs/date_interpreted"
                },
                {
                  "type": "null"
                }
              ]
            },
            "date_letters_granted": {
              "oneOf": [
                {
                  "$ref": "../defs/_shared_defs.schema.json#/$defs/date_interpreted"
                },
                {
                  "type": "null"
                }
              ]
            },
            "date_appraised_or_accounted": {
              "oneOf": [
                {
                  "$ref": "../defs/_shared_defs.schema.json#/$defs/date_interpreted"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "additionalProperties": false
        },
        "provisions_summary": {
          "type": [
            "string",
            "null"
          ]
        },
        "probate_note": {
          "type": [
            "string",
            "null"
          ]
        },
        "transcript": {
          "$ref": "../defs/_shared_defs.schema.json#/$defs/transcript_record"
        },
        "media_files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "../defs/_shared_defs.schema.json#/$defs/source_media"
          }
        }
      },
      "additionalProperties": false
    },
    "associated_people": {
      "type": "array",
      "items": {
        "$ref": "../defs/_shared_defs.schema.json#/$defs/associated_person_entry"
      }
    }
  },
  "additionalProperties": false
}
