{
  "_name": "other_miscellaneous.schema.json",
  "_path": "schemas/sources/other_miscellaneous.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://genealogy.archive/schemas/sources/other_miscellaneous.schema.json",
  "title": "OtherMiscellaneousRecord",
  "version": "1.0.0",
  "description": "Flexible open schema for miscellaneous historical sources including fraternal/lodge records, society rosters, ephemera, receipts, and untyped manuscript items.",
  "type": "object",
  "required": [
    "_name",
    "_path",
    "$schema",
    "description",
    "record_metadata",
    "other_details",
    "associated_people"
  ],
  "properties": {
    "_name": {
      "type": "string"
    },
    "_path": {
      "type": "string"
    },
    "$schema": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "description": "Contextual summary of this miscellaneous historical record."
    },
    "record_metadata": {
      "type": "object",
      "required": [
        "source_urn",
        "record_category",
        "record_type"
      ],
      "properties": {
        "source_urn": {
          "type": "string",
          "pattern": "^URN:OTHER:[0-9]{4}:[A-Z0-9_]+:[A-Za-z0-9_-]+$",
          "description": "Adheres to URN:OTHER:[YEAR]:[JURISDICTION]:[LOCATOR]."
        },
        "record_category": {
          "type": "string",
          "enum": [
            "OTHER",
            "FRATERNAL",
            "CIVIC",
            "EPHEMERA",
            "FINANCIAL"
          ],
          "default": "OTHER"
        },
        "record_type": {
          "type": "string",
          "enum": [
            "BIBLE",
            "DIARY",
            "CORRESP",
            "FIN",
            "EPHEM",
            "PHOTO",
            "LODGE_RECORD",
            "MEMBERSHIP_ROSTER",
            "RECEIPT",
            "MISC"
          ],
          "default": "MISC"
        }
      },
      "additionalProperties": false
    },
    "organization_or_entity": {
      "type": "object",
      "properties": {
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "location": {
          "oneOf": [
            {
              "$ref": "../defs/_shared_defs.schema.json#/$defs/location"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "other_details": {
      "type": "object",
      "required": [
        "item_date",
        "transcript",
        "media_files"
      ],
      "properties": {
        "item_date": {
          "$ref": "../defs/_shared_defs.schema.json#/$defs/date_interpreted"
        },
        "custom_fields": {
          "type": "object",
          "additionalProperties": true
        },
        "item_note": {
          "type": [
            "string",
            "null"
          ]
        },
        "transcript": {
          "$ref": "../defs/_shared_defs.schema.json#/$defs/transcript_record"
        },
        "media_files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "../defs/_shared_defs.schema.json#/$defs/source_media"
          }
        }
      },
      "additionalProperties": false
    },
    "associated_people": {
      "type": "array",
      "items": {
        "$ref": "../defs/_shared_defs.schema.json#/$defs/associated_person_entry"
      }
    }
  },
  "additionalProperties": false
}
