{
  "_name": "academic_credential.schema.json",
  "_path": "schemas/sources/academic_credential.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://genealogy.archive/schemas/sources/academic_credential.schema.json",
  "title": "AcademicCredentialRecord",
  "version": "1.0.0",
  "description": "Standardized schema for historical educational records including diplomas, graduation certificates, commencement programs, and school yearbooks.",
  "type": "object",
  "required": [
    "_name",
    "_path",
    "$schema",
    "description",
    "record_metadata",
    "institution",
    "academic_details",
    "associated_people"
  ],
  "properties": {
    "_name": {
      "type": "string"
    },
    "_path": {
      "type": "string"
    },
    "$schema": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "description": "Contextual summary of this academic credential record."
    },
    "record_metadata": {
      "type": "object",
      "required": [
        "source_urn",
        "record_category",
        "record_type"
      ],
      "properties": {
        "source_urn": {
          "type": "string",
          "pattern": "^URN:DIPLOMA:[0-9]{4}:[A-Z0-9_]+:[A-Za-z0-9_-]+$",
          "description": "Adheres to URN:DIPLOMA:[YEAR]:[JURISDICTION]:[LOCATOR]."
        },
        "record_category": {
          "type": "string",
          "enum": [
            "EDUCATION"
          ],
          "default": "EDUCATION"
        },
        "record_type": {
          "type": "string",
          "enum": [
            "DIPLOMA",
            "GRADUATION_CERTIFICATE",
            "YEARBOOK_PAGE",
            "COMMENCEMENT_PROGRAM",
            "CLASS_ROSTER",
            "TRANSCRIPT_REPORT"
          ],
          "default": "DIPLOMA"
        },
        "education_level": {
          "type": "string",
          "enum": [
            "ELEM",
            "HS",
            "COLL",
            "GRAD",
            "VOC",
            "OTHER"
          ]
        }
      },
      "additionalProperties": false
    },
    "institution": {
      "$ref": "../defs/_shared_defs.schema.json#/$defs/location",
      "description": "School, academy, college, or university facility."
    },
    "academic_details": {
      "type": "object",
      "required": [
        "credential_subject",
        "date_issued_or_published",
        "transcript",
        "media_files"
      ],
      "properties": {
        "credential_subject": {
          "type": "object",
          "required": [
            "full_name"
          ],
          "properties": {
            "person_id": {
              "$ref": "../defs/_shared_defs.schema.json#/$defs/person_id"
            },
            "full_name": {
              "$ref": "../defs/_shared_defs.schema.json#/$defs/canonical_name"
            },
            "degree_or_credential": {
              "type": [
                "string",
                "null"
              ]
            },
            "graduation_year": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1600,
              "maximum": 2100
            }
          },
          "additionalProperties": false
        },
        "date_issued_or_published": {
          "$ref": "../defs/_shared_defs.schema.json#/$defs/date_interpreted"
        },
        "publication_title": {
          "type": [
            "string",
            "null"
          ]
        },
        "page_or_plate": {
          "type": [
            "string",
            "null"
          ]
        },
        "credential_note": {
          "type": [
            "string",
            "null"
          ]
        },
        "transcript": {
          "$ref": "../defs/_shared_defs.schema.json#/$defs/transcript_record"
        },
        "media_files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "../defs/_shared_defs.schema.json#/$defs/source_media"
          }
        }
      },
      "additionalProperties": false
    },
    "associated_people": {
      "type": "array",
      "items": {
        "$ref": "../defs/_shared_defs.schema.json#/$defs/associated_person_entry"
      }
    }
  },
  "additionalProperties": false
}
