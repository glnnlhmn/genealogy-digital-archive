{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://genealogy.archive/schemas/sources/naturalization_record.schema.json",
  "title": "NaturalizationRecord",
  "version": "1.0.0",
  "description": "Standardized schema for historical naturalization instruments including Declarations of Intention, Petitions for Citizenship, Oaths of Allegiance, and Certificates.",
  "type": "object",
  "required": [
    "$schema",
    "description",
    "record_metadata",
    "court",
    "naturalization_details",
    "associated_people"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "description": {
      "type": "string",
      "description": "[REQUIRED] Contextual summary (e.g., '1905 Petition for Naturalization of Johan Lehman (Carlisle, Cumberland Co., PA)')."
    },
    "record_metadata": {
      "type": "object",
      "required": ["source_urn", "record_category", "record_type"],
      "properties": {
        "source_urn": {
          "type": "string",
          "pattern": "^URN:NATURALIZATION:[0-9]{4}:[A-Z0-9_]+:[A-Za-z0-9_-]+$",
          "description": "Adheres to URN:NATURALIZATION:[YEAR]:[JURISDICTION]:[LOCATOR]."
        },
        "record_category": {
          "type": "string",
          "enum": ["LEGAL", "CITIZENSHIP", "IMMIGRATION"],
          "default": "LEGAL"
        },
        "record_type": {
          "type": "string",
          "enum": [
            "DECLARATION_OF_INTENTION",
            "PETITION_FOR_NATURALIZATION",
            "CERTIFICATE_OF_CITIZENSHIP",
            "OATH_OF_ALLEGIANCE",
            "ORDER_OF_COURT"
          ],
          "default": "DECLARATION_OF_INTENTION"
        }
      },
      "additionalProperties": false
    },
    "court": {
      "type": "object",
      "required": ["court_name", "location"],
      "properties": {
        "court_name": {
          "type": "string",
          "description": "e.g., 'U.S. District Court for Middle District of Pennsylvania', 'Court of Common Pleas of Cumberland County'."
        },
        "location": {
          "$ref": "../defs/_shared_definitions.schema.json#/$defs/location",
          "description": "Seat of the court."
        },
        "presiding_judge_or_clerk": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "naturalization_details": {
      "type": "object",
      "required": [
        "docket_reference",
        "applicant",
        "event_date",
        "transcript",
        "media_files"
      ],
      "properties": {
        "docket_reference": {
          "type": "object",
          "required": ["locator"],
          "properties": {
            "locator": {
              "type": "string",
              "description": "Declaration, petition, or certificate number matching locator_naturalization_patterns."
            },
            "volume_page": { "type": ["string", "null"] },
            "certificate_stub_number": { "type": ["string", "null"] }
          },
          "additionalProperties": false
        },
        "applicant": {
          "type": "object",
          "required": ["full_name"],
          "properties": {
            "person_id": {
              "$ref": "../defs/_shared_definitions.schema.json#/$defs/person_id"
            },
            "full_name": {
              "$ref": "../defs/_shared_definitions.schema.json#/$defs/canonical_name"
            },
            "current_residence": {
              "oneOf": [
                { "$ref": "../defs/_shared_definitions.schema.json#/$defs/location" },
                { "type": "null" }
              ]
            },
            "date_of_birth": {
              "oneOf": [
                { "$ref": "../defs/_shared_definitions.schema.json#/$defs/date_interpreted" },
                { "type": "null" }
              ]
            },
            "place_of_birth": {
              "oneOf": [
                { "$ref": "../defs/_shared_definitions.schema.json#/$defs/location" },
                { "type": "null" }
              ]
            },
            "country_of_prior_allegiance": {
              "type": ["string", "null"],
              "description": "e.g., 'Emperor of Germany', 'King of Great Britain and Ireland'."
            },
            "port_and_date_of_arrival": {
              "type": "object",
              "properties": {
                "port_of_entry": { "type": ["string", "null"] },
                "arrival_date": {
                  "oneOf": [
                    { "$ref": "../defs/_shared_definitions.schema.json#/$defs/date_interpreted" },
                    { "type": "null" }
                  ]
                },
                "vessel_name": { "type": ["string", "null"] }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "event_date": {
          "$ref": "../defs/_shared_definitions.schema.json#/$defs/date_interpreted",
          "description": "Date sworn, signed, or certificate admitted."
        },
        "witnesses": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "occupation": { "type": ["string", "null"] },
              "residence": { "type": ["string", "null"] }
            },
            "additionalProperties": false
          },
          "description": "Affidavit witnesses certifying 5-year continuous residence and moral character."
        },
        "naturalization_note": {
          "type": ["string", "null"],
          "description": "Notes on previous declarations, certificate denials, or physical photo stubs."
        },
        "transcript": {
          "$ref": "../defs/_shared_definitions.schema.json#/$defs/transcript_record",
          "description": "Verbatim transcript, abstract, and search keywords."
        },
        "media_files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "../defs/_shared_definitions.schema.json#/$defs/source_media"
          },
          "description": "Scans of the petition leaf, declaration stub, or certificate."
        }
      },
      "additionalProperties": false
    },
    "associated_people": {
      "type": "array",
      "items": {
        "$ref": "../defs/_shared_definitions.schema.json#/$defs/associated_person_entry"
      },
      "description": "Array of participants (applicant, character witnesses, clerk, judge) mapped to roles and IDs."
    }
  },
  "additionalProperties": false
}