{
  "_name": "church_baptism.schema.json",
  "_path": "schemas/sources/church_baptism.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://genealogy.archive/schemas/sources/church_baptism.schema.json",
  "title": "ChurchBaptismRecord",
  "version": "1.0.0",
  "description": "Standardized schema for historical ecclesiastical baptismal, christening, and infant dedication registers and certificates.",
  "type": "object",
  "required": [
    "_name",
    "_path",
    "$schema",
    "description",
    "record_metadata",
    "church",
    "baptism_details",
    "associated_people"
  ],
  "properties": {
    "_name": {
      "type": "string"
    },
    "_path": {
      "type": "string"
    },
    "$schema": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "description": "Contextual summary of this baptism record."
    },
    "record_metadata": {
      "type": "object",
      "required": [
        "source_urn",
        "record_category",
        "record_type"
      ],
      "properties": {
        "source_urn": {
          "type": "string",
          "pattern": "^URN:BAPTISM:[0-9]{4}:[A-Z0-9_]+:[A-Za-z0-9_-]+$",
          "description": "Adheres to URN:BAPTISM:[YEAR]:[JURISDICTION]:[LOCATOR]."
        },
        "record_category": {
          "type": "string",
          "enum": [
            "CHURCH",
            "VITAL"
          ],
          "default": "CHURCH"
        },
        "record_type": {
          "type": "string",
          "enum": [
            "BAPTISM_REGISTER",
            "BAPTISM_CERTIFICATE",
            "CHRISTENING_ENTRY",
            "CRADLE_ROLL"
          ],
          "default": "BAPTISM_REGISTER"
        }
      },
      "additionalProperties": false
    },
    "church": {
      "$ref": "../defs/_shared_defs.schema.json#/$defs/location",
      "description": "Church parish or congregation facility."
    },
    "baptism_details": {
      "type": "object",
      "required": [
        "register_reference",
        "baptized_individual",
        "date_of_baptism",
        "transcript",
        "media_files"
      ],
      "properties": {
        "register_reference": {
          "type": "object",
          "required": [
            "locator"
          ],
          "properties": {
            "locator": {
              "type": "string"
            },
            "denomination": {
              "type": [
                "string",
                "null"
              ]
            },
            "volume_title": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false
        },
        "baptized_individual": {
          "type": "object",
          "required": [
            "full_name"
          ],
          "properties": {
            "person_id": {
              "$ref": "../defs/_shared_defs.schema.json#/$defs/person_id"
            },
            "full_name": {
              "$ref": "../defs/_shared_defs.schema.json#/$defs/canonical_name"
            },
            "sex": {
              "type": [
                "string",
                "null"
              ],
              "enum": [
                "Male",
                "Female",
                "Unknown",
                null
              ]
            },
            "date_of_birth": {
              "oneOf": [
                {
                  "$ref": "../defs/_shared_defs.schema.json#/$defs/date_interpreted"
                },
                {
                  "type": "null"
                }
              ]
            },
            "place_of_birth": {
              "oneOf": [
                {
                  "$ref": "../defs/_shared_defs.schema.json#/$defs/location"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "additionalProperties": false
        },
        "date_of_baptism": {
          "$ref": "../defs/_shared_defs.schema.json#/$defs/date_interpreted"
        },
        "baptism_note": {
          "type": [
            "string",
            "null"
          ]
        },
        "transcript": {
          "$ref": "../defs/_shared_defs.schema.json#/$defs/transcript_record"
        },
        "media_files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "../defs/_shared_defs.schema.json#/$defs/source_media"
          }
        }
      },
      "additionalProperties": false
    },
    "associated_people": {
      "type": "array",
      "items": {
        "$ref": "../defs/_shared_defs.schema.json#/$defs/associated_person_entry"
      }
    }
  },
  "additionalProperties": false
}
