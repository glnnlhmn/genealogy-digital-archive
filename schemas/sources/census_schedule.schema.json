{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://genealogy.archive/schemas/sources/census_schedule.schema.json",
  "title": "CensusScheduleRecord",
  "version": "1.0.1",
  "description": "Standardized canonical schema for all U.S. Federal Population and Decennial Census schedules (1790–1950).",
  "type": "object",
  "required": [
    "$schema",
    "description",
    "record_metadata",
    "page_metadata",
    "entries",
    "transcript",
    "media_files",
    "associated_people"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "description": {
      "type": "string",
      "description": "[REQUIRED] Contextual summary (e.g., '1900 U.S. Federal Census for Daniel Lehman Household (Frankford Twp, Cumberland Co., PA)')."
    },
    "record_metadata": {
      "type": "object",
      "required": ["source_urn", "record_category", "record_type", "census_year"],
      "properties": {
        "source_urn": {
          "type": "string",
          "pattern": "^URN:CENSUS:[0-9]{4}:[A-Z0-9_]+:[A-Za-z0-9_-]+$",
          "description": "Adheres to URN:CENSUS:[YEAR]:[JURISDICTION]:[LOCATOR]."
        },
        "record_category": {
          "type": "string",
          "enum": ["CENSUS"],
          "default": "CENSUS"
        },
        "record_type": {
          "type": "string",
          "enum": [
            "POPULATION_SCHEDULE",
            "MORTALITY_SCHEDULE",
            "AGRICULTURAL_SCHEDULE",
            "MANUFACTURING_SCHEDULE",
            "SLAVE_SCHEDULE",
            "VETERANS_SCHEDULE"
          ],
          "default": "POPULATION_SCHEDULE"
        },
        "census_year": {
          "type": "integer",
          "minimum": 1790,
          "maximum": 1950
        }
      },
      "additionalProperties": false
    },
    "page_metadata": {
      "$ref": "../defs/_census_definitions.schema.json#/$defs/census_page_metadata"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "../defs/_census_definitions.schema.json#/$defs/census_line_entry"
      },
      "description": "Line items enumerated on this schedule page."
    },
    "census_note": {
      "type": ["string", "null"],
      "description": "Archival notes regarding page tears, illegible lines, or double enumerations."
    },
    "transcript": {
      "$ref": "../defs/_shared_definitions.schema.json#/$defs/transcript_record",
      "description": "Verbatim transcript of enumerated household/line entries, abstract, and search keywords."
    },
    "media_files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "../defs/_shared_definitions.schema.json#/$defs/source_media"
      },
      "description": "Scans of the microfilm roll or National Archives digital page."
    },
    "associated_people": {
      "type": "array",
      "items": {
        "$ref": "../defs/_shared_definitions.schema.json#/$defs/associated_person_entry"
      },
      "description": "Array of participants (enumerated individuals, household head, enumerator) mapped to roles and IDs."
    }
  },
  "additionalProperties": false
}