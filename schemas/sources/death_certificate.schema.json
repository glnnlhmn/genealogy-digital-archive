{
  "_name": "death_certificate.schema.json",
  "_path": "schemas/sources/death_certificate.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://genealogy.archive/schemas/sources/death_certificate.schema.json",
  "title": "DeathCertificateSourceRecord",
  "version": "1.0.4",
  "description": "Standardized schema for civil death certificates, fetal death certificates, coroner inquests, and official death register entries.",
  "type": "object",
  "required": [
    "_name",
    "_path",
    "$schema",
    "description",
    "record_metadata",
    "death_certificate_details",
    "associated_people"
  ],
  "properties": {
    "_name": {
      "type": "string"
    },
    "_path": {
      "type": "string"
    },
    "$schema": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "description": "Contextual summary of this death source record."
    },
    "record_metadata": {
      "type": "object",
      "required": [
        "source_urn",
        "record_category",
        "record_type"
      ],
      "properties": {
        "source_urn": {
          "type": "string",
          "pattern": "^URN:DEATH:[0-9]{4}:[A-Z0-9_]+:[A-Za-z0-9_-]+$",
          "description": "Unique Uniform Resource Name adhering to URN:DEATH:[YEAR]:[JURISDICTION]:[LOCATOR]."
        },
        "record_category": {
          "type": "string",
          "enum": [
            "VITAL"
          ],
          "default": "VITAL"
        },
        "record_type": {
          "type": "string",
          "enum": [
            "DEATH_CERTIFICATE",
            "FETAL_DEATH",
            "CORONER_INQUEST",
            "TRANSIT_PERMIT",
            "REGISTER_ENTRY",
            "DELAYED_DEATH"
          ],
          "default": "DEATH_CERTIFICATE"
        }
      },
      "additionalProperties": false
    },
    "death_certificate_details": {
      "type": "object",
      "required": [
        "filing_details",
        "decedent",
        "event_details",
        "transcript",
        "media_files"
      ],
      "properties": {
        "filing_details": {
          "type": "object",
          "required": [
            "certificate_number"
          ],
          "properties": {
            "certificate_number": {
              "type": "string"
            },
            "registration_district": {
              "type": [
                "string",
                "null"
              ]
            },
            "date_filed": {
              "oneOf": [
                {
                  "$ref": "../defs/_shared_defs.schema.json#/$defs/date_interpreted"
                },
                {
                  "type": "null"
                }
              ]
            },
            "local_registrar": {
              "type": [
                "string",
                "null"
              ]
            },
            "sub_registrar": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false
        },
        "decedent": {
          "type": "object",
          "required": [
            "full_name",
            "sex"
          ],
          "properties": {
            "person_id": {
              "$ref": "../defs/_shared_defs.schema.json#/$defs/person_id"
            },
            "full_name": {
              "$ref": "../defs/_shared_defs.schema.json#/$defs/canonical_name"
            },
            "is_stillborn": {
              "type": [
                "boolean",
                "null"
              ],
              "default": false
            },
            "sex": {
              "type": "string",
              "enum": [
                "Male",
                "Female",
                "Unknown"
              ]
            },
            "color_or_race": {
              "type": [
                "string",
                "null"
              ]
            },
            "marital_status": {
              "type": [
                "string",
                "null"
              ],
              "enum": [
                "Single",
                "Married",
                "Widowed",
                "Divorced",
                "Unknown",
                null
              ]
            },
            "spouse_name": {
              "oneOf": [
                {
                  "$ref": "../defs/_shared_defs.schema.json#/$defs/canonical_name"
                },
                {
                  "type": "null"
                }
              ]
            },
            "date_of_birth": {
              "oneOf": [
                {
                  "$ref": "../defs/_shared_defs.schema.json#/$defs/date_interpreted"
                },
                {
                  "type": "null"
                }
              ]
            },
            "age": {
              "oneOf": [
                {
                  "$ref": "../defs/_shared_defs.schema.json#/$defs/age_record"
                },
                {
                  "type": "null"
                }
              ]
            },
            "birthplace": {
              "oneOf": [
                {
                  "$ref": "../defs/_shared_defs.schema.json#/$defs/location"
                },
                {
                  "type": "null"
                }
              ]
            },
            "citizen_country": {
              "type": [
                "string",
                "null"
              ]
            },
            "social_security_no": {
              "type": [
                "string",
                "null"
              ]
            },
            "armed_forces": {
              "type": [
                "string",
                "null"
              ]
            },
            "occupation": {
              "type": "object",
              "properties": {
                "usual": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "industry": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "additionalProperties": false
            },
            "parents": {
              "type": "object",
              "properties": {
                "father_name": {
                  "oneOf": [
                    {
                      "$ref": "../defs/_shared_defs.schema.json#/$defs/canonical_name"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "father_birthplace": {
                  "oneOf": [
                    {
                      "$ref": "../defs/_shared_defs.schema.json#/$defs/location"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "mother_maiden_name": {
                  "oneOf": [
                    {
                      "$ref": "../defs/_shared_defs.schema.json#/$defs/canonical_name"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "mother_birthplace": {
                  "oneOf": [
                    {
                      "$ref": "../defs/_shared_defs.schema.json#/$defs/location"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "event_details": {
          "type": "object",
          "required": [
            "date_of_death",
            "place_of_death"
          ],
          "properties": {
            "date_of_death": {
              "$ref": "../defs/_shared_defs.schema.json#/$defs/date_interpreted"
            },
            "time_of_death": {
              "type": [
                "string",
                "null"
              ]
            },
            "place_of_death": {
              "$ref": "../defs/_shared_defs.schema.json#/$defs/location"
            },
            "residence": {
              "oneOf": [
                {
                  "$ref": "../defs/_shared_defs.schema.json#/$defs/location"
                },
                {
                  "type": "null"
                }
              ]
            },
            "medical_certification": {
              "type": "object",
              "properties": {
                "cause": {
                  "$ref": "../defs/_shared_defs.schema.json#/$defs/cause_of_death"
                },
                "attending_physician": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "physician_address": {
                  "oneOf": [
                    {
                      "$ref": "../defs/_shared_defs.schema.json#/$defs/location"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "date_signed": {
                  "oneOf": [
                    {
                      "$ref": "../defs/_shared_defs.schema.json#/$defs/date_interpreted"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "additionalProperties": false
            },
            "informant": {
              "type": "object",
              "properties": {
                "name": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "address": {
                  "oneOf": [
                    {
                      "$ref": "../defs/_shared_defs.schema.json#/$defs/location"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "signature": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "additionalProperties": false
            },
            "disposition": {
              "type": "object",
              "properties": {
                "type": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "enum": [
                    "Burial",
                    "Cremation",
                    "Removal",
                    "Entombment",
                    "Donation",
                    "Other",
                    null
                  ]
                },
                "dispo_date": {
                  "oneOf": [
                    {
                      "$ref": "../defs/_shared_defs.schema.json#/$defs/date_interpreted"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "location": {
                  "oneOf": [
                    {
                      "$ref": "../defs/_shared_defs.schema.json#/$defs/location"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "undertaker": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "undertaker_address": {
                  "oneOf": [
                    {
                      "$ref": "../defs/_shared_defs.schema.json#/$defs/location"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "certificate_note": {
          "type": [
            "string",
            "null"
          ]
        },
        "transcript": {
          "$ref": "../defs/_shared_defs.schema.json#/$defs/transcript_record"
        },
        "media_files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "../defs/_shared_defs.schema.json#/$defs/source_media"
          }
        }
      },
      "additionalProperties": false
    },
    "associated_people": {
      "type": "array",
      "items": {
        "$ref": "../defs/_shared_defs.schema.json#/$defs/associated_person_entry"
      }
    }
  },
  "additionalProperties": false
}
