{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://genealogy.archive/schemas/sources/marriage_license.schema.json",
  "title": "MarriageLicenseRecord",
  "version": "1.0.4",
  "description": "Standardized schema for civil marriage applications, licenses, minister returns, certificates, and ledger registers.",
  "type": "object",
  "required": [
    "$schema",
    "description",
    "record_metadata",
    "marriage_details",
    "associated_people"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "description": "[REQUIRED] Human- and AI-readable contextual summary of this marriage source record (e.g., '1912 Marriage License of William Lehman and Annie Myers (Carlisle, Cumberland Co., PA)')."
    },
    "record_metadata": {
      "type": "object",
      "required": [
        "source_urn",
        "record_category",
        "record_type"
      ],
      "properties": {
        "source_urn": {
          "type": "string",
          "pattern": "^URN:MARRIAGE:[0-9]{4}:[A-Z0-9_]+:[A-Za-z0-9_-]+$",
          "description": "Unique Uniform Resource Name adhering to URN:MARRIAGE:[YEAR]:[JURISDICTION]:[LOCATOR]."
        },
        "record_category": {
          "type": "string",
          "enum": ["VITAL"],
          "default": "VITAL",
          "description": "Restricted to VITAL for all civil marriage registration and certificate records."
        },
        "record_type": {
          "type": "string",
          "enum": [
            "MARRIAGE_LICENSE",
            "MARRIAGE_CERTIFICATE",
            "MARRIAGE_REGISTER",
            "MINISTERS_RETURN",
            "MARRIAGE_BOND"
          ],
          "default": "MARRIAGE_LICENSE",
          "description": "Granular legal classification of the marriage instrument."
        }
      },
      "additionalProperties": false
    },
    "marriage_details": {
      "type": "object",
      "required": [
        "license_details",
        "groom",
        "bride",
        "transcript",
        "media_files"
      ],
      "properties": {
        "license_details": {
          "type": "object",
          "required": ["license_number"],
          "properties": {
            "license_number": {
              "type": "string",
              "description": "Official state, county, or local license number. Must align with patterns under 'locator_marriage_patterns' in schemas/naming/_token_registry.json."
            },
            "date_issued": {
              "oneOf": [
                { "$ref": "../defs/_shared_definitions.schema.json#/$defs/date_interpreted" },
                { "type": "null" }
              ],
              "description": "Date the marriage license was granted by the court or clerk."
            },
            "issuing_court_or_county": {
              "type": ["string", "null"],
              "description": "Court, county, or office granting the license (e.g., 'Orphans Court of Cumberland County')."
            },
            "clerk": {
              "type": ["string", "null"],
              "description": "Name or signature of the court clerk or recorder issuing the license."
            }
          },
          "additionalProperties": false
        },
        "groom": {
          "type": "object",
          "required": ["full_name"],
          "properties": {
            "person_id": {
              "$ref": "../defs/_shared_definitions.schema.json#/$defs/person_id",
              "description": "Controlled foreign key referencing the master Person Registry (/data/entities/people.json). Must be verified with 3 corroborating data points before assignment."
            },
            "full_name": {
              "$ref": "../defs/_shared_definitions.schema.json#/$defs/canonical_name",
              "description": "Groom's name parsed canonically or captured via raw_name."
            },
            "age": {
              "oneOf": [
                { "$ref": "../defs/_shared_definitions.schema.json#/$defs/age_record" },
                { "type": "null" }
              ],
              "description": "Age of groom as stated on the license application."
            },
            "date_of_birth": {
              "oneOf": [
                { "$ref": "../defs/_shared_definitions.schema.json#/$defs/date_interpreted" },
                { "type": "null" }
              ]
            },
            "birthplace": {
              "oneOf": [
                { "$ref": "../defs/_shared_definitions.schema.json#/$defs/location" },
                { "type": "null" }
              ],
              "description": "Birthplace of the groom. Must align with 'jurisdictions', 'counties', and 'states' in schemas/naming/_token_registry.json."
            },
            "residence": {
              "oneOf": [
                { "$ref": "../defs/_shared_definitions.schema.json#/$defs/location" },
                { "type": "null" }
              ],
              "description": "Groom's place of residence at the time of application."
            },
            "color_or_race": {
              "type": ["string", "null"]
            },
            "marital_history": {
              "type": "object",
              "properties": {
                "previous_marriages_count": { "type": ["integer", "null"], "minimum": 0 },
                "last_marriage_dissolution": {
                  "type": ["string", "null"],
                  "enum": ["Death", "Divorce", "Annulment", "None", null]
                }
              },
              "additionalProperties": false
            },
            "occupation": {
              "type": "object",
              "properties": {
                "usual": { "type": ["string", "null"] },
                "industry": { "type": ["string", "null"] }
              },
              "additionalProperties": false
            },
            "parents": {
              "type": "object",
              "properties": {
                "father_name": {
                  "oneOf": [
                    { "$ref": "../defs/_shared_definitions.schema.json#/$defs/canonical_name" },
                    { "type": "null" }
                  ]
                },
                "mother_maiden_name": {
                  "oneOf": [
                    { "$ref": "../defs/_shared_definitions.schema.json#/$defs/canonical_name" },
                    { "type": "null" }
                  ]
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "bride": {
          "type": "object",
          "required": ["full_name"],
          "properties": {
            "person_id": {
              "$ref": "../defs/_shared_definitions.schema.json#/$defs/person_id",
              "description": "Controlled foreign key referencing the master Person Registry (/data/entities/people.json). Must be verified with 3 corroborating data points before assignment."
            },
            "full_name": {
              "$ref": "../defs/_shared_definitions.schema.json#/$defs/canonical_name",
              "description": "Bride's legal name parsed canonically or captured via raw_name."
            },
            "maiden_name": {
              "type": ["string", "null"],
              "description": "Bride's maiden surname if previously married."
            },
            "age": {
              "oneOf": [
                { "$ref": "../defs/_shared_definitions.schema.json#/$defs/age_record" },
                { "type": "null" }
              ],
              "description": "Age of bride as stated on the license application."
            },
            "date_of_birth": {
              "oneOf": [
                { "$ref": "../defs/_shared_definitions.schema.json#/$defs/date_interpreted" },
                { "type": "null" }
              ]
            },
            "birthplace": {
              "oneOf": [
                { "$ref": "../defs/_shared_definitions.schema.json#/$defs/location" },
                { "type": "null" }
              ],
              "description": "Birthplace of the bride. Must align with 'jurisdictions', 'counties', and 'states' in schemas/naming/_token_registry.json."
            },
            "residence": {
              "oneOf": [
                { "$ref": "../defs/_shared_definitions.schema.json#/$defs/location" },
                { "type": "null" }
              ],
              "description": "Bride's place of residence at the time of application."
            },
            "color_or_race": {
              "type": ["string", "null"]
            },
            "marital_history": {
              "type": "object",
              "properties": {
                "previous_marriages_count": { "type": ["integer", "null"], "minimum": 0 },
                "last_marriage_dissolution": {
                  "type": ["string", "null"],
                  "enum": ["Death", "Divorce", "Annulment", "None", null]
                }
              },
              "additionalProperties": false
            },
            "occupation": {
              "type": "object",
              "properties": {
                "usual": { "type": ["string", "null"] },
                "industry": { "type": ["string", "null"] }
              },
              "additionalProperties": false
            },
            "parents": {
              "type": "object",
              "properties": {
                "father_name": {
                  "oneOf": [
                    { "$ref": "../defs/_shared_definitions.schema.json#/$defs/canonical_name" },
                    { "type": "null" }
                  ]
                },
                "mother_maiden_name": {
                  "oneOf": [
                    { "$ref": "../defs/_shared_definitions.schema.json#/$defs/canonical_name" },
                    { "type": "null" }
                  ]
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "ceremony_details": {
          "type": "object",
          "properties": {
            "date_of_marriage": {
              "oneOf": [
                { "$ref": "../defs/_shared_definitions.schema.json#/$defs/date_interpreted" },
                { "type": "null" }
              ],
              "description": "Actual date ceremony was solemnized."
            },
            "place_of_marriage": {
              "oneOf": [
                { "$ref": "../defs/_shared_definitions.schema.json#/$defs/location" },
                { "type": "null" }
              ],
              "description": "Standardized location of the ceremony. Must align with 'jurisdictions', 'counties', and 'states' in schemas/naming/_token_registry.json."
            },
            "officiator": {
              "type": "object",
              "properties": {
                "name": { "type": ["string", "null"] },
                "title": { "type": ["string", "null"], "description": "e.g., 'Minister of the Gospel', 'Pastor', 'Justice of the Peace'." },
                "religious_denomination": { "type": ["string", "null"] },
                "residence": {
                  "oneOf": [
                    { "$ref": "../defs/_shared_definitions.schema.json#/$defs/location" },
                    { "type": "null" }
                  ]
                }
              },
              "additionalProperties": false
            },
            "witnesses": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Verbatim names of attending witnesses signed to certificate."
            }
          },
          "additionalProperties": false
        },
        "license_note": {
          "type": ["string", "null"],
          "description": "Optional archival or contextual notes regarding endorsements, clerk notations, parental consents, or physical document condition."
        },
        "transcript": {
          "$ref": "../defs/_shared_definitions.schema.json#/$defs/transcript_record",
          "description": "Structured verbatim form field readout, abstract summary, and keyword indexing."
        },
        "media_files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "../defs/_shared_definitions.schema.json#/$defs/source_media"
          },
          "description": "Array of derivative media scan images comprising this source record."
        }
      },
      "additionalProperties": false
    },
    "associated_people": {
      "type": "array",
      "items": {
        "$ref": "../defs/_shared_definitions.schema.json#/$defs/associated_person_entry"
      },
      "description": "Canonical participants (groom, bride, parents, officiator, witnesses) mapped to standardized roles and IND IDs."
    }
  },
  "additionalProperties": false
}