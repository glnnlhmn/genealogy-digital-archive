{
  "_name": "marriage_license.schema.json",
  "_path": "schemas/sources/marriage_license.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://genealogy.archive/schemas/sources/marriage_license.schema.json",
  "title": "MarriageLicenseRecord",
  "version": "1.0.4",
  "description": "Standardized schema for civil marriage applications, licenses, minister returns, certificates, and ledger registers.",
  "type": "object",
  "required": [
    "_name",
    "_path",
    "$schema",
    "description",
    "record_metadata",
    "marriage_details",
    "associated_people"
  ],
  "properties": {
    "_name": {
      "type": "string"
    },
    "_path": {
      "type": "string"
    },
    "$schema": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "description": "Contextual summary of this marriage source record."
    },
    "record_metadata": {
      "type": "object",
      "required": [
        "source_urn",
        "record_category",
        "record_type"
      ],
      "properties": {
        "source_urn": {
          "type": "string",
          "pattern": "^URN:MARRIAGE:[0-9]{4}:[A-Z0-9_]+:[A-Za-z0-9_-]+$",
          "description": "Unique Uniform Resource Name adhering to URN:MARRIAGE:[YEAR]:[JURISDICTION]:[LOCATOR]."
        },
        "record_category": {
          "type": "string",
          "enum": [
            "VITAL"
          ],
          "default": "VITAL"
        },
        "record_type": {
          "type": "string",
          "enum": [
            "MARRIAGE_LICENSE",
            "MARRIAGE_CERTIFICATE",
            "MARRIAGE_REGISTER",
            "MINISTERS_RETURN",
            "MARRIAGE_BOND"
          ],
          "default": "MARRIAGE_LICENSE"
        }
      },
      "additionalProperties": false
    },
    "marriage_details": {
      "type": "object",
      "required": [
        "license_details",
        "groom",
        "bride",
        "transcript",
        "media_files"
      ],
      "properties": {
        "license_details": {
          "type": "object",
          "required": [
            "license_number"
          ],
          "properties": {
            "license_number": {
              "type": "string",
              "description": "Official state, county, or local license number."
            },
            "date_issued": {
              "oneOf": [
                {
                  "$ref": "../defs/_shared_defs.schema.json#/$defs/date_interpreted"
                },
                {
                  "type": "null"
                }
              ]
            },
            "issuing_court_or_county": {
              "type": [
                "string",
                "null"
              ]
            },
            "clerk": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false
        },
        "groom": {
          "type": "object",
          "required": [
            "full_name"
          ],
          "properties": {
            "person_id": {
              "$ref": "../defs/_shared_defs.schema.json#/$defs/person_id"
            },
            "full_name": {
              "$ref": "../defs/_shared_defs.schema.json#/$defs/canonical_name"
            },
            "age": {
              "oneOf": [
                {
                  "$ref": "../defs/_shared_defs.schema.json#/$defs/age_record"
                },
                {
                  "type": "null"
                }
              ]
            },
            "date_of_birth": {
              "oneOf": [
                {
                  "$ref": "../defs/_shared_defs.schema.json#/$defs/date_interpreted"
                },
                {
                  "type": "null"
                }
              ]
            },
            "birthplace": {
              "oneOf": [
                {
                  "$ref": "../defs/_shared_defs.schema.json#/$defs/location"
                },
                {
                  "type": "null"
                }
              ]
            },
            "residence": {
              "oneOf": [
                {
                  "$ref": "../defs/_shared_defs.schema.json#/$defs/location"
                },
                {
                  "type": "null"
                }
              ]
            },
            "color_or_race": {
              "type": [
                "string",
                "null"
              ]
            },
            "marital_history": {
              "type": "object",
              "properties": {
                "previous_marriages_count": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0
                },
                "last_marriage_dissolution": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "enum": [
                    "Death",
                    "Divorce",
                    "Annulment",
                    "None",
                    null
                  ]
                }
              },
              "additionalProperties": false
            },
            "occupation": {
              "type": "object",
              "properties": {
                "usual": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "industry": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "additionalProperties": false
            },
            "parents": {
              "type": "object",
              "properties": {
                "father_name": {
                  "oneOf": [
                    {
                      "$ref": "../defs/_shared_defs.schema.json#/$defs/canonical_name"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "mother_maiden_name": {
                  "oneOf": [
                    {
                      "$ref": "../defs/_shared_defs.schema.json#/$defs/canonical_name"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "bride": {
          "type": "object",
          "required": [
            "full_name"
          ],
          "properties": {
            "person_id": {
              "$ref": "../defs/_shared_defs.schema.json#/$defs/person_id"
            },
            "full_name": {
              "$ref": "../defs/_shared_defs.schema.json#/$defs/canonical_name"
            },
            "maiden_name": {
              "type": [
                "string",
                "null"
              ]
            },
            "age": {
              "oneOf": [
                {
                  "$ref": "../defs/_shared_defs.schema.json#/$defs/age_record"
                },
                {
                  "type": "null"
                }
              ]
            },
            "date_of_birth": {
              "oneOf": [
                {
                  "$ref": "../defs/_shared_defs.schema.json#/$defs/date_interpreted"
                },
                {
                  "type": "null"
                }
              ]
            },
            "birthplace": {
              "oneOf": [
                {
                  "$ref": "../defs/_shared_defs.schema.json#/$defs/location"
                },
                {
                  "type": "null"
                }
              ]
            },
            "residence": {
              "oneOf": [
                {
                  "$ref": "../defs/_shared_defs.schema.json#/$defs/location"
                },
                {
                  "type": "null"
                }
              ]
            },
            "color_or_race": {
              "type": [
                "string",
                "null"
              ]
            },
            "marital_history": {
              "type": "object",
              "properties": {
                "previous_marriages_count": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0
                },
                "last_marriage_dissolution": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "enum": [
                    "Death",
                    "Divorce",
                    "Annulment",
                    "None",
                    null
                  ]
                }
              },
              "additionalProperties": false
            },
            "occupation": {
              "type": "object",
              "properties": {
                "usual": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "industry": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "additionalProperties": false
            },
            "parents": {
              "type": "object",
              "properties": {
                "father_name": {
                  "oneOf": [
                    {
                      "$ref": "../defs/_shared_defs.schema.json#/$defs/canonical_name"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "mother_maiden_name": {
                  "oneOf": [
                    {
                      "$ref": "../defs/_shared_defs.schema.json#/$defs/canonical_name"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "ceremony_details": {
          "type": "object",
          "properties": {
            "date_of_marriage": {
              "oneOf": [
                {
                  "$ref": "../defs/_shared_defs.schema.json#/$defs/date_interpreted"
                },
                {
                  "type": "null"
                }
              ]
            },
            "place_of_marriage": {
              "oneOf": [
                {
                  "$ref": "../defs/_shared_defs.schema.json#/$defs/location"
                },
                {
                  "type": "null"
                }
              ]
            },
            "officiator": {
              "type": "object",
              "properties": {
                "name": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "title": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "religious_denomination": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "residence": {
                  "oneOf": [
                    {
                      "$ref": "../defs/_shared_defs.schema.json#/$defs/location"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "additionalProperties": false
            },
            "witnesses": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        },
        "license_note": {
          "type": [
            "string",
            "null"
          ]
        },
        "transcript": {
          "$ref": "../defs/_shared_defs.schema.json#/$defs/transcript_record"
        },
        "media_files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "../defs/_shared_defs.schema.json#/$defs/source_media"
          }
        }
      },
      "additionalProperties": false
    },
    "associated_people": {
      "type": "array",
      "items": {
        "$ref": "../defs/_shared_defs.schema.json#/$defs/associated_person_entry"
      }
    }
  },
  "additionalProperties": false
}
