{
  "_name": "land_deed.schema.json",
  "_path": "schemas/sources/land_deed.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://genealogy.archive/schemas/sources/land_deed.schema.json",
  "title": "LandDeedRecord",
  "version": "1.0.0",
  "description": "Standardized schema for historical land deeds, indentures, conveyances, warrants, patents, surveys, and mortgages.",
  "type": "object",
  "required": [
    "_name",
    "_path",
    "$schema",
    "description",
    "record_metadata",
    "recorder_office",
    "deed_details",
    "associated_people"
  ],
  "properties": {
    "_name": {
      "type": "string"
    },
    "_path": {
      "type": "string"
    },
    "$schema": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "description": "Contextual summary of this land deed record."
    },
    "record_metadata": {
      "type": "object",
      "required": [
        "source_urn",
        "record_category",
        "record_type"
      ],
      "properties": {
        "source_urn": {
          "type": "string",
          "pattern": "^URN:LAND:[0-9]{4}:[A-Z0-9_]+:[A-Za-z0-9_-]+$",
          "description": "Adheres to URN:LAND:[YEAR]:[JURISDICTION]:[LOCATOR]."
        },
        "record_category": {
          "type": "string",
          "enum": [
            "LAND",
            "LEGAL",
            "PROPERTY"
          ],
          "default": "LAND"
        },
        "record_type": {
          "type": "string",
          "enum": [
            "DEED_INDENTURE",
            "QUITCLAIM_DEED",
            "WARRANT",
            "PATENT",
            "SURVEY",
            "MORTGAGE",
            "SHERIFF_DEED",
            "RELEASE_DOWER"
          ],
          "default": "DEED_INDENTURE"
        }
      },
      "additionalProperties": false
    },
    "recorder_office": {
      "type": "object",
      "required": [
        "office_title",
        "location"
      ],
      "properties": {
        "office_title": {
          "type": "string"
        },
        "location": {
          "$ref": "../defs/_shared_defs.schema.json#/$defs/location"
        },
        "recorder_or_deputy": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "deed_details": {
      "type": "object",
      "required": [
        "recording_reference",
        "dates",
        "grantors",
        "grantees",
        "parcel",
        "transcript",
        "media_files"
      ],
      "properties": {
        "recording_reference": {
          "type": "object",
          "required": [
            "locator"
          ],
          "properties": {
            "locator": {
              "type": "string"
            },
            "deed_book": {
              "type": [
                "string",
                "null"
              ]
            },
            "page_number": {
              "type": [
                "string",
                "null"
              ]
            },
            "instrument_number": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false
        },
        "dates": {
          "type": "object",
          "required": [
            "date_written"
          ],
          "properties": {
            "date_written": {
              "$ref": "../defs/_shared_defs.schema.json#/$defs/date_interpreted"
            },
            "date_acknowledged": {
              "oneOf": [
                {
                  "$ref": "../defs/_shared_defs.schema.json#/$defs/date_interpreted"
                },
                {
                  "type": "null"
                }
              ]
            },
            "date_recorded": {
              "oneOf": [
                {
                  "$ref": "../defs/_shared_defs.schema.json#/$defs/date_interpreted"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "additionalProperties": false
        },
        "grantors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "full_name"
            ],
            "properties": {
              "person_id": {
                "$ref": "../defs/_shared_defs.schema.json#/$defs/person_id"
              },
              "full_name": {
                "$ref": "../defs/_shared_defs.schema.json#/$defs/canonical_name"
              },
              "residence": {
                "oneOf": [
                  {
                    "$ref": "../defs/_shared_defs.schema.json#/$defs/location"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "relationship_to_grantee": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "grantees": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "full_name"
            ],
            "properties": {
              "person_id": {
                "$ref": "../defs/_shared_defs.schema.json#/$defs/person_id"
              },
              "full_name": {
                "$ref": "../defs/_shared_defs.schema.json#/$defs/canonical_name"
              },
              "residence": {
                "oneOf": [
                  {
                    "$ref": "../defs/_shared_defs.schema.json#/$defs/location"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "financials": {
          "type": "object",
          "properties": {
            "consideration_amount": {
              "type": [
                "string",
                "null"
              ]
            },
            "dower_relinquished": {
              "type": [
                "boolean",
                "null"
              ]
            }
          },
          "additionalProperties": false
        },
        "parcel": {
          "type": "object",
          "required": [
            "location"
          ],
          "properties": {
            "location": {
              "$ref": "../defs/_shared_defs.schema.json#/$defs/location"
            },
            "tract_name": {
              "type": [
                "string",
                "null"
              ]
            },
            "acreage": {
              "type": [
                "string",
                "null"
              ]
            },
            "metes_and_bounds_summary": {
              "type": [
                "string",
                "null"
              ]
            },
            "neighboring_landowners": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "prior_deed_recital": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false
        },
        "deed_note": {
          "type": [
            "string",
            "null"
          ]
        },
        "transcript": {
          "$ref": "../defs/_shared_defs.schema.json#/$defs/transcript_record"
        },
        "media_files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "../defs/_shared_defs.schema.json#/$defs/source_media"
          }
        }
      },
      "additionalProperties": false
    },
    "associated_people": {
      "type": "array",
      "items": {
        "$ref": "../defs/_shared_defs.schema.json#/$defs/associated_person_entry"
      }
    }
  },
  "additionalProperties": false
}
