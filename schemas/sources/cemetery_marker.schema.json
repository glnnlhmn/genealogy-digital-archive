{
  "_name": "cemetery_marker.schema.json",
  "_path": "schemas/sources/cemetery_marker.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://genealogy.archive/schemas/sources/cemetery_marker.schema.json",
  "title": "CemeteryMarkerRecord",
  "version": "1.0.0",
  "description": "Standardized schema for historical cemetery markers, headstones, monuments, mausoleum crypts, and memorial inscriptions.",
  "type": "object",
  "required": [
    "_name",
    "_path",
    "$schema",
    "description",
    "record_metadata",
    "cemetery",
    "marker",
    "associated_people"
  ],
  "properties": {
    "_name": {
      "type": "string"
    },
    "_path": {
      "type": "string"
    },
    "$schema": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "description": "Contextual summary of this cemetery marker record."
    },
    "record_metadata": {
      "type": "object",
      "required": [
        "source_urn",
        "record_category",
        "record_type"
      ],
      "properties": {
        "source_urn": {
          "type": "string",
          "pattern": "^URN:CEMETERY:[0-9]{4}:[A-Z0-9_]+:[A-Za-z0-9_-]+$",
          "description": "Unique Uniform Resource Name adhering to URN:CEMETERY:[YEAR]:[JURISDICTION]:[LOCATOR]."
        },
        "record_category": {
          "type": "string",
          "enum": [
            "CEMETERY"
          ],
          "default": "CEMETERY"
        },
        "record_type": {
          "type": "string",
          "enum": [
            "CEMETERY_MARKER",
            "HEADSTONE",
            "FOOTSTONE",
            "FAMILY_MONUMENT",
            "MEMORIAL_PLAQUE",
            "MAUSOLEUM_CRYPT"
          ],
          "default": "CEMETERY_MARKER"
        }
      },
      "additionalProperties": false
    },
    "cemetery": {
      "$ref": "../defs/_shared_defs.schema.json#/$defs/location",
      "description": "Cemetery facility and geographic location."
    },
    "marker": {
      "type": "object",
      "required": [
        "interments",
        "transcript",
        "media_files"
      ],
      "properties": {
        "plot_location": {
          "type": [
            "string",
            "null"
          ]
        },
        "memorial_identifiers": {
          "type": "object",
          "properties": {
            "findagrave_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "billiongraves_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "cemetery_grave_id": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false
        },
        "monument_profile": {
          "type": "object",
          "properties": {
            "marker_type": {
              "type": [
                "string",
                "null"
              ],
              "enum": [
                "Upright Headstone",
                "Flat Marker",
                "Slant",
                "Obelisk",
                "Ledger",
                "Table Tomb",
                "Footstone",
                "Monument",
                "Other",
                null
              ]
            },
            "material": {
              "type": [
                "string",
                "null"
              ],
              "enum": [
                "Marble",
                "Granite",
                "Sandstone",
                "Limestone",
                "Slate",
                "Fieldstone",
                "Bronze",
                "Other",
                null
              ]
            },
            "carver": {
              "type": [
                "string",
                "null"
              ]
            },
            "physical_condition": {
              "type": [
                "string",
                "null"
              ],
              "enum": [
                "Sound",
                "Weathered",
                "Broken/Repaired",
                "Sunken",
                "Illegible",
                "Overgrown",
                null
              ]
            }
          },
          "additionalProperties": false
        },
        "interments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "inscribed_name"
            ],
            "properties": {
              "person_id": {
                "$ref": "../defs/_shared_defs.schema.json#/$defs/person_id"
              },
              "inscribed_name": {
                "$ref": "../defs/_shared_defs.schema.json#/$defs/canonical_name"
              },
              "birth_date": {
                "oneOf": [
                  {
                    "$ref": "../defs/_shared_defs.schema.json#/$defs/date_interpreted"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "death_date": {
                "oneOf": [
                  {
                    "$ref": "../defs/_shared_defs.schema.json#/$defs/date_interpreted"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "age_at_death": {
                "oneOf": [
                  {
                    "$ref": "../defs/_shared_defs.schema.json#/$defs/age_record"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "relationship_inscribed": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "marker_note": {
          "type": [
            "string",
            "null"
          ]
        },
        "transcript": {
          "$ref": "../defs/_shared_defs.schema.json#/$defs/transcript_record"
        },
        "media_files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "../defs/_shared_defs.schema.json#/$defs/source_media"
          }
        }
      },
      "additionalProperties": false
    },
    "associated_people": {
      "type": "array",
      "items": {
        "$ref": "../defs/_shared_defs.schema.json#/$defs/associated_person_entry"
      }
    }
  },
  "additionalProperties": false
}
