{
  "_name": "divorce_report.schema.json",
  "_path": "schemas/sources/divorce_report.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://genealogy.archive/schemas/sources/divorce_report.schema.json",
  "title": "DivorceReportRecord",
  "version": "1.0.4",
  "description": "Standardized schema for civil divorce reports, divorce decrees, court docket entries, and annulments.",
  "type": "object",
  "required": [
    "_name",
    "_path",
    "$schema",
    "description",
    "record_metadata",
    "divorce_report_details",
    "associated_people"
  ],
  "properties": {
    "_name": {
      "type": "string"
    },
    "_path": {
      "type": "string"
    },
    "$schema": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "description": "Contextual summary of this divorce record."
    },
    "record_metadata": {
      "type": "object",
      "required": [
        "source_urn",
        "record_category",
        "record_type"
      ],
      "properties": {
        "source_urn": {
          "type": "string",
          "pattern": "^URN:DIVORCE:[0-9]{4}:[A-Z0-9_]+:[A-Za-z0-9_-]+$",
          "description": "Unique Uniform Resource Name adhering to URN:DIVORCE:[YEAR]:[JURISDICTION]:[LOCATOR]."
        },
        "record_category": {
          "type": "string",
          "enum": [
            "LEGAL"
          ],
          "default": "LEGAL"
        },
        "record_type": {
          "type": "string",
          "enum": [
            "DIVORCE_REPORT",
            "DIVORCE_DECREE",
            "DOCKET_ENTRY",
            "ANNULMENT"
          ],
          "default": "DIVORCE_REPORT"
        }
      },
      "additionalProperties": false
    },
    "divorce_report_details": {
      "type": "object",
      "required": [
        "court",
        "husband",
        "wife",
        "decree",
        "transcript",
        "media_files"
      ],
      "properties": {
        "court": {
          "type": "object",
          "required": [
            "court_name"
          ],
          "properties": {
            "court_name": {
              "type": "string"
            },
            "docket_number": {
              "type": [
                "string",
                "null"
              ]
            },
            "state_file_number": {
              "type": [
                "string",
                "null"
              ]
            },
            "jurisdiction": {
              "$ref": "../defs/_shared_defs.schema.json#/$defs/location"
            },
            "presiding_judge": {
              "type": [
                "string",
                "null"
              ]
            },
            "clerk": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false
        },
        "husband": {
          "type": "object",
          "required": [
            "full_name"
          ],
          "properties": {
            "person_id": {
              "$ref": "../defs/_shared_defs.schema.json#/$defs/person_id"
            },
            "full_name": {
              "$ref": "../defs/_shared_defs.schema.json#/$defs/canonical_name"
            },
            "age": {
              "oneOf": [
                {
                  "$ref": "../defs/_shared_defs.schema.json#/$defs/age_record"
                },
                {
                  "type": "null"
                }
              ]
            },
            "residence": {
              "oneOf": [
                {
                  "$ref": "../defs/_shared_defs.schema.json#/$defs/location"
                },
                {
                  "type": "null"
                }
              ]
            },
            "occupation": {
              "type": "object",
              "properties": {
                "usual": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "industry": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "additionalProperties": false
            },
            "attorney": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false
        },
        "wife": {
          "type": "object",
          "required": [
            "full_name"
          ],
          "properties": {
            "person_id": {
              "$ref": "../defs/_shared_defs.schema.json#/$defs/person_id"
            },
            "full_name": {
              "$ref": "../defs/_shared_defs.schema.json#/$defs/canonical_name"
            },
            "maiden_name": {
              "type": [
                "string",
                "null"
              ]
            },
            "age": {
              "oneOf": [
                {
                  "$ref": "../defs/_shared_defs.schema.json#/$defs/age_record"
                },
                {
                  "type": "null"
                }
              ]
            },
            "residence": {
              "oneOf": [
                {
                  "$ref": "../defs/_shared_defs.schema.json#/$defs/location"
                },
                {
                  "type": "null"
                }
              ]
            },
            "occupation": {
              "type": "object",
              "properties": {
                "usual": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "industry": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "additionalProperties": false
            },
            "attorney": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false
        },
        "marriage": {
          "type": "object",
          "properties": {
            "date_of_marriage": {
              "oneOf": [
                {
                  "$ref": "../defs/_shared_defs.schema.json#/$defs/date_interpreted"
                },
                {
                  "type": "null"
                }
              ]
            },
            "place_of_marriage": {
              "oneOf": [
                {
                  "$ref": "../defs/_shared_defs.schema.json#/$defs/location"
                },
                {
                  "type": "null"
                }
              ]
            },
            "date_of_separation": {
              "oneOf": [
                {
                  "$ref": "../defs/_shared_defs.schema.json#/$defs/date_interpreted"
                },
                {
                  "type": "null"
                }
              ]
            },
            "number_of_minor_children": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "decree": {
          "type": "object",
          "required": [
            "date_decree_granted"
          ],
          "properties": {
            "date_decree_granted": {
              "$ref": "../defs/_shared_defs.schema.json#/$defs/date_interpreted"
            },
            "legal_grounds": {
              "type": [
                "string",
                "null"
              ]
            },
            "plaintiff": {
              "type": [
                "string",
                "null"
              ],
              "enum": [
                "Husband",
                "Wife",
                "Other",
                null
              ]
            },
            "decree_type": {
              "type": [
                "string",
                "null"
              ],
              "enum": [
                "Absolute (A Vinculo Matrimonii)",
                "Bed and Board (A Mensa Et Thoro)",
                "Annulment",
                "Dismissed",
                "Other",
                null
              ],
              "default": "Absolute (A Vinculo Matrimonii)"
            },
            "custody_details": {
              "type": [
                "string",
                "null"
              ]
            },
            "alimony_awarded": {
              "type": [
                "boolean",
                "null"
              ]
            }
          },
          "additionalProperties": false
        },
        "record_note": {
          "type": [
            "string",
            "null"
          ]
        },
        "transcript": {
          "$ref": "../defs/_shared_defs.schema.json#/$defs/transcript_record"
        },
        "media_files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "../defs/_shared_defs.schema.json#/$defs/source_media"
          }
        }
      },
      "additionalProperties": false
    },
    "associated_people": {
      "type": "array",
      "items": {
        "$ref": "../defs/_shared_defs.schema.json#/$defs/associated_person_entry"
      }
    }
  },
  "additionalProperties": false
}
