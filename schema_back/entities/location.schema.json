{
  "_name": "location.schema.json",
  "_path": "schemas/entities/location.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://genealogy.archive/schemas/entities/location.schema.json",
  "title": "Master Civil Location Entity Schema",
  "version": "1.2.0",
  "description": "Authoritative civil jurisdiction entity schema, independent of assertion-level location definitions.",
  "type": "object",
  "required": [
    "location_id",
    "canonical_name",
    "aliases",
    "jurisdiction"
  ],
  "properties": {
    "location_id": {
      "$ref": "../defs/_shared_defs.schema.json#/$defs/location_id"
    },
    "canonical_name": {
      "type": "string",
      "description": "Clean, unpunctuated civil designation: [Jurisdiction, County County, State, Country]."
    },
    "aliases": {
      "type": "array",
      "description": "Recognized spelling variations, historical abbreviations, and colloquial names.",
      "items": {
        "type": "string"
      }
    },
    "jurisdiction": {
      "type": "object",
      "description": "Normalized civil administrative hierarchy.",
      "required": [
        "country"
      ],
      "properties": {
        "local_jurisdiction": {
          "type": [
            "string",
            "null"
          ],
          "description": "Township, borough, parish, town, or city."
        },
        "county": {
          "type": [
            "string",
            "null"
          ],
          "description": "County or administrative district name without the word 'County'."
        },
        "state_or_province": {
          "type": [
            "string",
            "null"
          ],
          "description": "State, province, historical duchy, or region."
        },
        "country": {
          "type": "string",
          "description": "Sovereign nation or crown territory."
        }
      },
      "additionalProperties": false
    },
    "temporal_validity": {
      "type": [
        "object",
        "null"
      ],
      "description": "Civil establishment, reorganization, and dissolution boundaries.",
      "properties": {
        "date_established": {
          "type": [
            "string",
            "null"
          ]
        },
        "date_dissolved": {
          "type": [
            "string",
            "null"
          ]
        },
        "predecessor_location_id": {
          "$ref": "../defs/_shared_defs.schema.json#/$defs/location_id"
        },
        "successor_location_id": {
          "$ref": "../defs/_shared_defs.schema.json#/$defs/location_id"
        }
      },
      "additionalProperties": false
    },
    "historical_periods": {
      "type": "array",
      "description": "Chronological slices of jurisdictional changes, partitions, and boundary shifts.",
      "items": {
        "type": "object",
        "required": [
          "period_id",
          "date_start",
          "country"
        ],
        "properties": {
          "period_id": {
            "type": "string"
          },
          "date_start": {
            "type": "string"
          },
          "date_end": {
            "type": [
              "string",
              "null"
            ]
          },
          "local_jurisdiction": {
            "type": [
              "string",
              "null"
            ]
          },
          "county": {
            "type": [
              "string",
              "null"
            ]
          },
          "state_or_province": {
            "type": [
              "string",
              "null"
            ]
          },
          "country": {
            "type": "string"
          },
          "note": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "notes": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "../defs/_shared_defs.schema.json#/$defs/note_entry"
      }
    },
    "last_updated": {
      "type": "string",
      "description": "ISO-8601 timestamp tracking entity modification."
    }
  },
  "additionalProperties": false
}