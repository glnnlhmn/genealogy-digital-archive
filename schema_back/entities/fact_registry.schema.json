{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://genealogy.archive/schemas/entities/fact_registry.schema.json",
  "title": "Fact_Registry",
  "version": "1.0.2",
  "description": "Master administrative registry container for discrete fact assertions, utilizing centralized registry definitions.",
  "type": "object",
  "required": [
    "$schema",
    "schema_version",
    "created_at",
    "last_modified",
    "total_facts",
    "facts"
  ],
  "properties": {
    "$schema": {
      "$ref": "../defs/_registry_shared_defs.schema.json#/$defs/registry_header/properties/$schema"
    },
    "schema_version": {
      "$ref": "../defs/_registry_shared_defs.schema.json#/$defs/registry_header/properties/schema_version",
      "const": "1.0.2"
    },
    "created_at": {
      "$ref": "../defs/_registry_shared_defs.schema.json#/$defs/registry_header/properties/created_at"
    },
    "last_modified": {
      "$ref": "../defs/_registry_shared_defs.schema.json#/$defs/registry_header/properties/last_modified"
    },
    "total_facts": {
      "$ref": "../defs/_registry_shared_defs.schema.json#/$defs/total_count",
      "description": "Total count of discrete fact assertions contained in the registry."
    },
    "facts": {
      "type": "array",
      "description": "List of master fact assertion records.",
      "items": {
        "$ref": "fact.schema.json"
      }
    }
  },
  "additionalProperties": false
}