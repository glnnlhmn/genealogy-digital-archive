{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://genealogy.archive/schemas/entities/newspaper_registry.schema.json",
  "title": "Newspaper_Registry",
  "version": "1.1.0",
  "description": "Master administrative registry container cataloging newspaper articles, metadata, and primary subjects.",
  "type": "object",
  "unevaluatedProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "last_modified",
    "total_articles",
    "articles"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "JSON Schema draft specification URI."
    },
    "schema_version": {
      "type": "string",
      "const": "1.1.0",
      "description": "Version identifier for the newspaper registry schema."
    },
    "last_modified": {
      "$ref": "../defs/_shared_defs.schema.json#/$defs/date_iso",
      "description": "[REQUIRED] ISO-8601 date of last registry compilation."
    },
    "total_articles": {
      "$ref": "../defs/_registry_shared_defs.schema.json#/$defs/total_count",
      "description": "[REQUIRED] Total count of newspaper article entries cataloged in the registry."
    },
    "articles": {
      "type": "array",
      "description": "[REQUIRED] Cataloged list of newspaper articles.",
      "items": {
        "type": "object",
        "unevaluatedProperties": false,
        "required": [
          "source_urn",
          "pub_code",
          "pub_date",
          "record_type",
          "headline",
          "file_path",
          "primary_subjects"
        ],
        "properties": {
          "source_urn": {
            "$ref": "../defs/_shared_defs.schema.json#/$defs/record_urn",
            "description": "[REQUIRED] Archival Uniform Resource Name for the newspaper clipping."
          },
          "pub_code": {
            "type": "string",
            "maxLength": 6,
            "description": "[REQUIRED] Standardized newspaper publication authority token."
          },
          "pub_date": {
            "$ref": "../defs/_shared_defs.schema.json#/$defs/date_interpreted",
            "description": "[REQUIRED] Interpreted publication date of the article."
          },
          "record_type": {
            "type": "string",
            "maxLength": 6,
            "description": "[REQUIRED] Classification token defined under 'news_classifications' in _token_registry.json."
          },
          "headline": {
            "type": "string",
            "description": "[REQUIRED] Verbatim or standardized article headline."
          },
          "file_path": {
            "type": "string",
            "description": "[REQUIRED] Relative path to the granular archival record file on disk."
          },
          "primary_subjects": {
            "type": "array",
            "minItems": 1,
            "description": "[REQUIRED] Primary individuals featured as the central focus of the article.",
            "items": {
              "$ref": "../defs/_shared_defs.schema.json#/$defs/person_brief"
            }
          }
        }
      }
    }
  }
}